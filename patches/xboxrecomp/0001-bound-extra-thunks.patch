+    check(*(uint32_t *)(mem + THUNK_VA - 12) == 0x80000000u,
+          "lookbehind preserves ordinal zero", NULL);
+    check(*(uint32_t *)(mem + THUNK_VA - 16) == (0x80000000u | 379u),
+          "lookbehind preserves an out-of-range ordinal", NULL);
