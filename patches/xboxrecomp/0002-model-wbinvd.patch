diff --git a/tools/recomp/test_lifter_wbinvd.py b/tools/recomp/test_lifter_wbinvd.py
new file mode 100644
index 0000000..d530260
--- /dev/null
+++ b/tools/recomp/test_lifter_wbinvd.py
@@ -0,0 +1,47 @@
+"""WBINVD orders coherent host memory and leaves guest flags unchanged."""
+
+import unittest
+
+from .disasm import BasicBlock, Disassembler, Instruction, Operand
+from .lifter import Lifter, lift_basic_block
+
+
+class WbinvdTest(unittest.TestCase):
+    def test_instruction_emits_full_host_fence(self):
+        instruction = Disassembler().disassemble_function(
+            bytes.fromhex("0f09"), 0x10000, 0x10002
+        )[0]
+        self.assertEqual(instruction.mnemonic, "wbinvd")
+        lifter = Lifter()
+        code = " ".join(lifter.lift_instruction(instruction))
+        self.assertIn("atomic_thread_fence(memory_order_seq_cst);", code)
+        self.assertNotIn("RECOMP_UNIMPL", code)
+        self.assertEqual(lifter.unimplemented, {})
+
+    def test_comparison_survives_wbinvd(self):
+        compare = Instruction(0, 2, "cmp", "eax, ebx", "39d8")
+        compare.operands = [
+            Operand(type="reg", reg="eax"), Operand(type="reg", reg="ebx")
+        ]
+        flush = Instruction(2, 2, "wbinvd", "", "0f09")
+        branch = Instruction(4, 2, "je", "0x40", "7440")
+        branch.jump_target = 0x40
+        control, _ = lift_basic_block(
+            Lifter(), BasicBlock(start=0, instructions=[compare, branch])
+        )
+        self.assertIn("CMP_EQ", "\n".join(control))
+        code, _ = lift_basic_block(
+            Lifter(), BasicBlock(start=0, instructions=[compare, flush, branch])
+        )
+        self.assertIn("CMP_EQ", "\n".join(code))
+
+    def test_invd_remains_unimplemented(self):
+        instruction = Instruction(0, 2, "invd", "", "0f08")
+        lifter = Lifter()
+        code = " ".join(lifter.lift_instruction(instruction))
+        self.assertIn("RECOMP_UNIMPL", code)
+        self.assertIn("invd", lifter.unimplemented)
+
+
+if __name__ == "__main__":
+    unittest.main()
