+uint32_t xbox_MemoryAvailablePages(void)
+{
+    uint64_t used = 1u + XBOX_GPU_INSTANCE_DEFAULT / CONTIG_PAGE;
+    uint64_t total = g_xbox_total_ram / CONTIG_PAGE;
+    uint32_t previous = 0, tracked_end = XBOX_HEAP_BASE;
+    uint32_t contiguous, p;
+    int i;
+
+    /* The image extent includes its header; gaps count conservatively. The
+     * scratch region is reserved, while the main stack counts its XBE-declared
+     * initial commitment rather than the runtime's 8 MB address reservation. */
+    if (g_xbox_image_hi) {
+        uint32_t start = g_xbox_image_lo < XBOX_BASE_ADDRESS
+                       ? g_xbox_image_lo : XBOX_BASE_ADDRESS;
+        used += ((uint64_t)g_xbox_image_hi + CONTIG_PAGE - 1) / CONTIG_PAGE
+              - start / CONTIG_PAGE;
+    }
+    used += (g_xbox_stack_base - g_xbox_region_base) / CONTIG_PAGE;
+    used += g_xbox_stack_commit_pages;
+
+    /* Heap blocks can share a page. Count the union, not one rounded size per
+     * block, and keep untracked bump allocations conservative if the table
+     * fills. The table is sorted by address, including after reuse. */
+    AcquireSRWLockShared(&g_heap_lock);
+    for (i = 0; i < g_heap_block_count; ++i) {
+        uint32_t first, end, block_end;
+        if (!g_heap_blocks[i].size)
+            continue;
+        block_end = g_heap_blocks[i].addr + g_heap_blocks[i].size;
+        if (block_end > tracked_end)
+            tracked_end = block_end;
+        if (g_heap_blocks[i].free)
+            continue;
+        first = g_heap_blocks[i].addr / CONTIG_PAGE;
+        end = (uint32_t)(((uint64_t)block_end + CONTIG_PAGE - 1) / CONTIG_PAGE);
+        if (first < previous)
+            first = previous;
+        if (end > first)
+            used += end - first;
+        if (end > previous)
+            previous = end;
+    }
+    if (g_heap_block_count >= XBOX_HEAP_MAX_BLOCKS && g_heap_next > tracked_end) {
+        uint32_t first = tracked_end / CONTIG_PAGE;
+        uint32_t end = (uint32_t)(((uint64_t)g_heap_next + CONTIG_PAGE - 1)
+                                  / CONTIG_PAGE);
+        if (first < previous)
+            first = previous;
+        if (end > first)
+            used += end - first;
+    }
+    ReleaseSRWLockShared(&g_heap_lock);
+
+    contig_lock();
+    contiguous = g_contig_pages_in_use;
+    for (p = CONTIG_USABLE; p < CONTIG_PAGES; ++p) {
+        if (g_contig_used[p] == 1)
+            --contiguous; /* already counted as reserved GPU instance memory */
+    }
+    contig_unlock();
+    used += contiguous;
+    used += guest_vmem_committed_pages();
+
+    return used >= total ? 0 : (uint32_t)(total - used);
+}
