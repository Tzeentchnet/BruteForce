+uint32_t guest_vmem_committed_pages(void)
+{
+    uint32_t count = 0, p, pages;
+
+    AcquireSRWLockShared(&s_lock);
+    pages = s_pages ? (s_top - s_lo) / VMEM_PAGE : 0;
+    for (p = 0; p < pages; ++p) {
+        if (s_pages[p].state == MEM_COMMIT_FLAG)
+            ++count;
+    }
+    ReleaseSRWLockShared(&s_lock);
+    return count;
+}
