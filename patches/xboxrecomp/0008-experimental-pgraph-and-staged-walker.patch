+int xbox_Nv2aGraphSoftwareTrap(uint32_t subch, uint32_t method, uint32_t data)
+{
+    static int enabled = -1;
+    DWORD started;
+
+    if (enabled < 0) {
+        const char *env = getenv("RECOMP_PGRAPH_IRQ");
+        enabled = env && *env == '1';
+    }
+    if (!enabled)
+        return 0;
+    if (subch != 0 || method != 0x100u || data == 0) {
+        fprintf(stderr, "  [PGRAPH] unsupported software trap %u:%03X data=%08X\n",
+                subch, method, data);
+        abort();
+    }
+    if (!xbox_IrqSafePointsStrict() || !xbox_GetConnectedInterrupt(NV2A_VECTOR)) {
+        fprintf(stderr, "  [PGRAPH] software trap requires the strict IRQ gate "
+                        "and a connected GPU ISR\n");
+        abort();
+    }
+    kernel_timer_start();
+    if (!g_graph_done) {
+        g_graph_done = CreateEventA(NULL, FALSE, FALSE, NULL);
+        if (!g_graph_done) {
+            fprintf(stderr, "  [PGRAPH] cannot create trap event: %lu\n",
+                    (unsigned long)GetLastError());
+            abort();
+        }
+    }
+    if (InterlockedCompareExchange(&g_graph_pending, GRAPH_ARMING, GRAPH_IDLE) != GRAPH_IDLE) {
+        fprintf(stderr, "  [PGRAPH] nested software trap\n");
+        abort();
+    }
+    g_graph_data = data;
+    BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PGRAPH_NSOURCE) = NV2A_PGRAPH_NOTIFY;
+    BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PGRAPH_TRAP_ADDR) =
+        method | (subch << 16);
+    BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PGRAPH_TRAP_DATA) = data;
+    InterlockedOr((volatile LONG *)&BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PGRAPH_INTR),
+                  NV2A_PGRAPH_NOTIFY);
+    if (BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PGRAPH_INTR_EN) & NV2A_PGRAPH_NOTIFY)
+        InterlockedOr((volatile LONG *)&BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PMC_INTR_0),
+                      NV2A_PMC_INTR_PGRAPH);
+    InterlockedExchange(&g_graph_pending, GRAPH_PENDING);
+    xbox_HostTimerWake();
+    {
+        LONG bit = (LONG)(1u << (data & 31u));
+        LONG seen = InterlockedOr(&g_graph_seen_methods, bit);
+        LONG traps = InterlockedIncrement(&g_graph_traps);
+        if (!(seen & bit) || traps <= 4)
+            fprintf(stderr, "  [PGRAPH] software trap method=%03X data=%08X\n", method, data);
+    }
+    started = GetTickCount();
+    while (xbox_Nv2aGraphTrapPending()) {
+        DWORD wait = WaitForSingleObject(g_graph_done, 2);
+        if (wait == WAIT_FAILED) {
+            fprintf(stderr, "  [PGRAPH] trap wait failed: %lu\n",
+                    (unsigned long)GetLastError());
+            abort();
+        }
+        xbox_Nv2aAckBusyBits();
+        if ((DWORD)(GetTickCount() - started) > 5000) {
+            fprintf(stderr, "  [PGRAPH] waiting for guest software-trap acknowledgement\n");
+            started = GetTickCount();
+        }
+    }
+    return 1;
+}
+
+int xbox_Nv2aGraphAcknowledgeTrap(uint32_t context, uint32_t data)
+{
+    uint32_t interrupt, remaining;
+
+    if (InterlockedCompareExchange(&g_graph_pending, GRAPH_IDLE, GRAPH_IDLE) != GRAPH_PENDING)
+        return 0;
+    interrupt = xbox_GetConnectedInterrupt(NV2A_VECTOR);
+    if (!interrupt || context != BRIDGE_MEM32(interrupt + 4) ||
+        data != g_graph_data ||
+        BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PGRAPH_TRAP_ADDR) != 0x100u ||
+        BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PGRAPH_TRAP_DATA) != data) {
+        fprintf(stderr, "  [PGRAPH] invalid software-trap acknowledgement "
+                        "context=%08X data=%08X (expected %08X)\n",
+                context, data, g_graph_data);
+        abort();
+    }
+    if (InterlockedCompareExchange(&g_graph_pending, GRAPH_HANDLING, GRAPH_PENDING) != GRAPH_PENDING) {
+        fprintf(stderr, "  [PGRAPH] concurrent software-trap acknowledgement\n");
+        abort();
+    }
+    remaining = (uint32_t)InterlockedAnd(
+        (volatile LONG *)&BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PGRAPH_INTR),
+        (LONG)~NV2A_PGRAPH_NOTIFY) & ~NV2A_PGRAPH_NOTIFY;
+    if (!(remaining & BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PGRAPH_INTR_EN)))
+        InterlockedAnd((volatile LONG *)&BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PMC_INTR_0),
+                       (LONG)~NV2A_PMC_INTR_PGRAPH);
+    if (InterlockedIncrement(&g_graph_acks) <= 4)
+        fprintf(stderr, "  [PGRAPH] guest acknowledged software trap %08X\n", data);
+    return 1;
+}
+
+void xbox_Nv2aGraphCompleteTrap(void)
+{
+    if (InterlockedCompareExchange(&g_graph_pending, GRAPH_IDLE, GRAPH_HANDLING) != GRAPH_HANDLING) {
+        fprintf(stderr, "  [PGRAPH] software trap completed in an invalid state\n");
+        abort();
+    }
+    InterlockedExchange(&g_graph_posted, 0);
+    if (!SetEvent(g_graph_done)) {
+        fprintf(stderr, "  [PGRAPH] cannot wake trapped GPU: %lu\n",
+                (unsigned long)GetLastError());
+        abort();
+    }
+}
+
+static void kernel_graph_deliver(void)
+{
+    int claimed;
+
+    if (InterlockedCompareExchange(&g_graph_pending, GRAPH_IDLE, GRAPH_IDLE) != GRAPH_PENDING ||
+        !(BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PGRAPH_INTR_EN) & NV2A_PGRAPH_NOTIFY) ||
+        !BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PMC_INTR_EN_0)) {
+        InterlockedExchange(&g_graph_posted, 0);
+        return;
+    }
+    claimed = kernel_call_isr(NV2A_VECTOR);
+    if (InterlockedIncrement(&g_graph_deliveries) <= 4 || claimed < 0)
+        fprintf(stderr, "  [PGRAPH] ISR %s\n",
+                claimed < 0 ? "not callable" : claimed ? "claimed" : "declined");
+    if (claimed < 0) {
+        fprintf(stderr, "  [PGRAPH] connected GPU ISR cannot be called\n");
+        abort();
+    }
+    if (!claimed)
+        InterlockedExchange(&g_graph_posted, 0);
+}
+
+static void kernel_graph_maybe_raise(void)
+{
+    if (InterlockedCompareExchange(&g_graph_pending, GRAPH_IDLE, GRAPH_IDLE) != GRAPH_PENDING ||
+        !(BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PGRAPH_INTR_EN) & NV2A_PGRAPH_NOTIFY))
+        return;
+    InterlockedOr((volatile LONG *)&BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PMC_INTR_0),
+                  NV2A_PMC_INTR_PGRAPH);
+    if (InterlockedCompareExchange(&g_graph_pending, GRAPH_IDLE, GRAPH_IDLE) != GRAPH_PENDING) {
+        if (!(BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PGRAPH_INTR) &
+              BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PGRAPH_INTR_EN)))
+            InterlockedAnd((volatile LONG *)&BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PMC_INTR_0),
+                           (LONG)~NV2A_PMC_INTR_PGRAPH);
+        return;
+    }
+    if (!BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PMC_INTR_EN_0) ||
+        InterlockedCompareExchange(&g_graph_posted, 1, 0) != 0)
+        return;
+    xbox_IrqSetHandler(XBOX_IRQ_PGRAPH, kernel_graph_deliver);
+    switch (xbox_IrqPost(XBOX_IRQ_PGRAPH)) {
+    case XBOX_IRQ_GATED:
+        kernel_graph_deliver();
+        xbox_DispatchGateLeave();
+        break;
+    case XBOX_IRQ_POSTED:
+        break;
+    default:
+        fprintf(stderr, "  [PGRAPH] software trap was delivered without the IRQ gate\n");
+        abort();
+    }
+}
 
