     s_tot_segments++;
+    return ring_jump;
+}
+
+void nv2a_pb_scan_wrapped(uint32_t start_va, uint32_t end_va,
+                          uint32_t put_va, uint32_t fallback_va)
+{
+    uint32_t next = nv2a_pb_scan_segment(start_va, end_va);
+    if (!next) {
+        static unsigned missing_jumps;
+        if (++missing_jumps <= 8 || missing_jumps % 100 == 0)
+            fprintf(stderr, "  [PB] ring wrap #%u has no observed JUMP; "
+                            "resync at 0x%08X\n", missing_jumps, fallback_va);
+        next = fallback_va;
+    }
+    if (next > put_va) {
+        fprintf(stderr, "  [PB] ring wrap target 0x%08X is beyond PUT 0x%08X, resync\n",
+                next, put_va);
+        s_segment_packet.left = 0;
+        return;
+    }
+    if (next < put_va)
+        nv2a_pb_scan_segment(next, put_va);
 }
