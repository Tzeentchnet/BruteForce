+static inline int software_cull_active(void)
+{
+    return s_gpu.software_cull_enabled && s_gpu.cull.enabled &&
+           s_gpu.cull.programmed == 3;
+}
+
+static inline int software_cull_rejects(float area)
+{
+    int front;
+
+    if (!software_cull_active())
+        return 0;
+    if (s_gpu.cull.face == 0x408u)
+        return 1;
+    /* Framebuffer Y increases downwards: positive area is clockwise. */
+    front = (area > 0.0f) == (s_gpu.cull.front == 0x900u);
+    return (s_gpu.cull.face == 0x404u) == front;
+}
