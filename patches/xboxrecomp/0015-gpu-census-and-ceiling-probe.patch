 }
 
+/* RECOMP_GPU_CENSUS (nv2a_census.h): what this draw asks of the GPU, in the
+ * registers' own encodings. Read from the executor's state and the register
+ * mirror, not from what the rasteriser does with them. */
+#define CENSUS_RECENT_SURFACES 16
+static struct {
+    uint32_t base, bytes, size;         /* resolved colour surface, w << 16 | h */
+} s_census_surfaces[CENSUS_RECENT_SURFACES];
+static uint32_t s_census_surface_next;
+
+static void census_note_surface(void)
+{
+    uint32_t base = s_gpu.color_offset ? dma_resolve(s_gpu.color_offset) : 0;
+    uint32_t bytes = s_gpu.pitch * (s_gpu.clip_y + s_gpu.clip_h);
+    uint32_t i;
+
+    if (!base || !bytes)
+        return;
+    for (i = 0; i < CENSUS_RECENT_SURFACES; i++)
+        if (s_census_surfaces[i].base == base) {
+            s_census_surfaces[i].bytes = bytes;
+            s_census_surfaces[i].size = s_gpu.clip_w << 16 | s_gpu.clip_h;
+            return;
+        }
+    i = s_census_surface_next++ % CENSUS_RECENT_SURFACES;
+    s_census_surfaces[i].base = base;
+    s_census_surfaces[i].bytes = bytes;
+    s_census_surfaces[i].size = s_gpu.clip_w << 16 | s_gpu.clip_h;
+}
+
+static void census_draw(char path)
+{
+    uint32_t n = s_gpu.idx_count, st, used = 0, stages = 0;
+    uint32_t zeta = s_gpu.zeta_offset ? dma_resolve(s_gpu.zeta_offset) : 0;
+
+    census_note_surface();
+    nv2a_census_add("path", (uint32_t)path, n);
+    nv2a_census_add("source", s_gpu.inline_active ? (s_gpu.imm_count ? 'M' : 'I') : 'A', n);
+    nv2a_census_add("primitive", s_gpu.prim, n);
+    nv2a_census_add("surface_size", s_gpu.clip_w << 16 | s_gpu.clip_h, n);
+    nv2a_census_add("surface_format", s_gpu.format, n);
+    nv2a_census_add("surface_aa", (uint32_t)s_gpu.aa_sx << 4 | (uint32_t)s_gpu.aa_sy, n);
+    nv2a_census_add("combiner_stages", s_gpu.rc_seen ? (s_gpu.rc.control & 0xFF) : 0xFFFFFFFFu, n);
+    nv2a_census_add("combiner_control", s_gpu.rc.control, n);
+    nv2a_census_add("stage_program", s_gpu.rc.stage_program, n);
+    for (st = 0; st < 4; st++) {
+        uint32_t mode = s_gpu.rc_seen ? (s_gpu.rc.stage_program >> (st * 5)) & 0x1F
+                                      : (st == 0 && s_gpu.texs[0].valid);
+        if (mode) {
+            used |= 1u << st;
+            nv2a_census_add("stage_mode", st << 8 | mode, n);
+        }
+    }
+    for (st = 0; st < 4; st++) {
+        const Texture *t = &s_gpu.texs[st];
+        uint32_t layout, i;
+        if (!(used & (1u << st)))
+            continue;
+        stages++;
+        layout = d3d8_format_dxt_block_bytes(t->color) ? 2
+                 : d3d8_format_is_swizzled(t->color) ? 1 : 0;
+        nv2a_census_add("texture_format", t->color | layout << 8 | (uint32_t)t->cube << 12
+                        | (uint32_t)t->valid << 16, n);
+        nv2a_census_add("texture_size", t->width << 16 | t->height, n);
+        nv2a_census_add("texture_address", t->addr_u | t->addr_v << 8, n);
+        nv2a_census_add("texture_filter", t->filter, n);
+        nv2a_census_add("texture_levels", t->levels, n);
+        for (i = 0; i < CENSUS_RECENT_SURFACES; i++)
+            if (s_census_surfaces[i].bytes && t->offset >= s_census_surfaces[i].base
+                && t->offset - s_census_surfaces[i].base < s_census_surfaces[i].bytes)
+                nv2a_census_add("render_to_texture", s_census_surfaces[i].size, n);
+        if (zeta && t->offset == zeta)
+            nv2a_census_add("zeta_as_texture", t->color, n);
+    }
+    nv2a_census_add("texture_stages", stages, n);
+    nv2a_census_add("blend", s_gpu.blend_enable ? s_gpu.blend_sfactor << 16
+                    | (s_gpu.blend_dfactor & 0xFFFF) : 0, n);
+    nv2a_census_add("blend_equation", s_gpu.blend_enable ? s_gpu.blend_equation : 0, n);
+    nv2a_census_add("alpha_test", s_gpu.alpha_test ? s_gpu.alpha_func : 0, n);
+    nv2a_census_add("depth_test", s_gpu.depth_test ? s_gpu.depth_func : 0, n);
+    nv2a_census_add("depth_write", s_gpu.depth_mask, n);
+    nv2a_census_add("color_mask", s_gpu.color_mask, n);
+    nv2a_census_add("fog", s_gpu.fog_enable ? s_gpu.fog_mode : 0, n);
+    nv2a_census_add("cull", s_reg[0x0308 / 4] ? s_reg[0x039C / 4] << 16 | s_reg[0x03A0 / 4] : 0, n);
+    nv2a_census_add("stencil_test", s_reg[0x032C / 4] ? s_reg[0x0364 / 4] : 0, n);
+    if (s_reg[0x032C / 4])
+        nv2a_census_add("stencil_ops", s_reg[0x0370 / 4] << 20 ^ s_reg[0x0374 / 4] << 10
+                        ^ s_reg[0x0378 / 4], n);
+    nv2a_census_add("window_clip_type", s_reg[0x02B4 / 4], n);
+    nv2a_census_add("clip_plane_mode", s_gpu.clip_plane_mode, n);
+    nv2a_census_add("point_params", s_reg[0x0318 / 4] | s_reg[0x031C / 4] << 4, n);
+    nv2a_census_add("polygon_offset", s_reg[0x0330 / 4] | s_reg[0x0334 / 4] << 4
+                    | s_reg[0x0338 / 4] << 8, n);
+    if (path == 'P')
+        nv2a_census_add("program_constant_writes", s_reg[0x1E98 / 4], n);
+    if (path == 'F')
+        nv2a_census_add("ffp_lighting", s_reg[0x0314 / 4], n);
+}
+
+/* RECOMP_PROBE_DROP_TRANSFORMED=1: a measurement aid, never a renderer
+ * setting. Batches that need a transform (a vertex program or the
+ * fixed-function pipeline) are dropped before any vertex is transformed, so
+ * a run shows what the pushbuffer walk and the title cost without vertex or
+ * pixel work. The picture is wrong by design. */
+static int probe_drop_transformed(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char *e = getenv("RECOMP_PROBE_DROP_TRANSFORMED");
+        on = e && strcmp(e, "1") == 0;
+        if (on)
+            fprintf(stderr, "[GPU] PROBE: dropping every transformed batch"
+                            " (RECOMP_PROBE_DROP_TRANSFORMED)\n");
+    }
+    return on;
+}
+
 static void raster_batch(void)
 {
     uint32_t i;
     uint32_t before = s_gpu.tris_drawn;
     int textured = 0;
 
+    if (nv2a_census_active())
+        census_draw(s_gpu.idx_count < 3 ? 'x' : batch_uses_program() ? 'P'
+                    : batch_is_ffp() ? 'F' : batch_is_screen_space() ? 'S' : 'U');
     if (s_gpu.idx_count < 3)
         return;
     if (batch_uses_program() || batch_is_ffp()) {
+        if (probe_drop_transformed())
+            return;
         raster_batch_program();
         return;
     }
@@ -4186,6 +4309,11 @@ void nv2a_pb_exec_method(uint32_t subch, uint32_t method, uint32_t param)
             fprintf(stderr, "[FTRACE] clear %X surf %08X %ux%u colour %08X%c",
                     param, s_gpu.color_offset, s_gpu.clip_w, s_gpu.clip_h,
                     s_gpu.clear_color, 10);
+        if (nv2a_census_active()) {
+            census_note_surface();
+            nv2a_census_add("clear_flags", param, 0);
+            nv2a_census_add("clear_surface", s_gpu.clip_w << 16 | s_gpu.clip_h, 0);
+        }
         clear_surface(param);
         if (param & 0x01)                         /* Z */
             zbuf_clear();
@@ -4359,6 +4487,9 @@ void nv2a_pb_exec_method(uint32_t subch, uint32_t method, uint32_t param)
             }
         }
         frame_stats_flip();
+        if (nv2a_census_active())
+            nv2a_census_add("flip_surface", s_gpu.drawn_w << 16 | s_gpu.drawn_h, 0);
+        nv2a_census_flip();
         s_gpu.drawn_stale = 1;
         if (s_backend && s_backend->flip)
             s_backend->flip();
