+
+static void xbackend_from_xf(const Nv2aVshOutput *v, Nv2aXVertex *o)
+{
+    o->x = v->pos[0];
+    o->y = v->pos[1];
+    o->z = v->pos[2];
+    o->rhw = 1.0f / v->pos[3];
+    memcpy(o->d0, v->d0, sizeof o->d0);
+    memcpy(o->d1, v->d1, sizeof o->d1);
+    o->fog = fog_factor(v->fog[0]);
+    o->pad[0] = o->pad[1] = o->pad[2] = 0.0f;
+    memcpy(o->tc, v->tex, sizeof o->tc);
+}
+
+static void copy_texture(const Texture *t, Nv2aTexture *o)
+{
+    o->offset = t->offset;
+    o->width  = t->width;
+    o->height = t->height;
+    o->pitch  = t->pitch;
+    o->color  = t->color;
+    o->addr_u = t->addr_u;
+    o->addr_v = t->addr_v;
+    o->levels = t->pitch ? 1 : t->levels;
+    o->filter = t->filter;
+}
+
+/* The batch state an extended back end needs besides the vertices. */
+static void fill_xbatch(Nv2aXBatch *xb, const Nv2aRenderState *rs)
+{
+    static int no_rc = -1;
+    int st;
+
+    if (no_rc < 0)
+        no_rc = getenv("RECOMP_NO_COMBINERS") != NULL;
+    memset(xb, 0, sizeof *xb);
+    xb->state = rs;
+    xb->rc = s_gpu.rc_seen && !no_rc ? &s_gpu.rc : NULL;
+    for (st = 0; st < 4; st++) {
+        const Texture *t = &s_gpu.texs[st];
+        if (!t->valid)
+            continue;
+        copy_texture(t, &xb->tex[st]);
+        xb->tex_valid[st] = 1;
+        xb->tex_normalized[st] = tex_size_from_format(t->color) != 0;
+        xb->tex_cube[st] = (uint8_t)t->cube;
