+/* The extended path's vertices: everything the CPU path's per-pixel loop
+ * reads (xf_rows), per vertex. */
+static Nv2aXVertex *s_xverts;
+static uint32_t s_xcount;
+static float fog_factor(float d);
+
+static Nv2aXVertex *xbackend_slot(void)
+{
+    if (!s_xverts
+        && !(s_xverts = (Nv2aXVertex *)calloc(NV_BACKEND_MAX_VERTS, sizeof *s_xverts)))
+        return NULL;
+    if (s_xcount + 3 > NV_BACKEND_MAX_VERTS)
