+add_test(NAME nv2a-gpu-audit-on COMMAND nv2a-gpu-audit-test on
+    "${CMAKE_CURRENT_BINARY_DIR}/audit-on.csv")
diff --git a/tests/nv2a_gpu_audit/nv2a_gpu_audit_test.c b/tests/nv2a_gpu_audit/nv2a_gpu_audit_test.c
new file mode 100644
index 0000000..8cdc5db
--- /dev/null
+++ b/tests/nv2a_gpu_audit/nv2a_gpu_audit_test.c
@@ -0,0 +1,88 @@
+/* Standalone synthetic observer fixture; no guest image or backend required. */
+#include "nv2a_gpu_audit.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static int set_environment(const char *name, const char *value)
+{
+#ifdef _WIN32
+    return _putenv_s(name, value) == 0;
+#else
+    return setenv(name, value, 1) == 0;
+#endif
+}
+
+static int contains(const char *report, const char *line)
+{
+    if (strstr(report, line))
+        return 1;
+    fprintf(stderr, "missing audit row: %s\n", line);
+    return 0;
+}
+
+int main(int argc, char **argv)
+{
+    static char report[65536];
+    FILE *f;
+    size_t bytes;
+    int on;
+
+    if (argc != 3 || (strcmp(argv[1], "on") && strcmp(argv[1], "off")))
+        return 2;
+    on = strcmp(argv[1], "on") == 0;
+    if (!set_environment("RECOMP_GPU_AUDIT", on ? "1" : "0") ||
+        !set_environment("RECOMP_GPU_AUDIT_FILE", argv[2]))
+        return 2;
+
+    nv2a_gpu_audit_method(0, 0x1D70, 7);
+    nv2a_gpu_audit_semaphore(NV2A_AUDIT_SEMAPHORE_DIRECT);
+    nv2a_gpu_audit_method(5, 0x0310, 9);
+    nv2a_gpu_audit_method(4, 0x1D70, 11);
+    nv2a_gpu_audit_unhandled(4, 0x1D70);
+    nv2a_gpu_audit_begin(5);
+    nv2a_gpu_audit_input(NV2A_AUDIT_ARRAY, 3, 3);
+    nv2a_gpu_audit_backend(NV2A_AUDIT_GPU_VERTEX_REJECTED, 3);
+    nv2a_gpu_audit_fallback(NV2A_AUDIT_VSH_REJECTED);
+    nv2a_gpu_audit_route(NV2A_AUDIT_CPU_PROGRAM);
+    nv2a_gpu_audit_end(1, 0, 0, 0, 0);
+    nv2a_gpu_audit_begin(5);
+    nv2a_gpu_audit_input(NV2A_AUDIT_INLINE, 4, 4);
+    nv2a_gpu_audit_inline_stride(16);
+    nv2a_gpu_audit_drop(NV2A_AUDIT_SHORT_BATCH);
+    nv2a_gpu_audit_end(0, 0, 0, 0, 0);
+    nv2a_gpu_audit_clear(0xF0, 16, 16, 3, 0x10000, 0x20000);
+    nv2a_gpu_audit_flip(16, 16, 0x108);
+    nv2a_gpu_audit_write();
+
+    f = fopen(argv[2], "r");
+    if (!on) {
+        if (f)
+            fclose(f);
+        return f ? 1 : 0;
+    }
+    if (!f)
+        return 1;
+    bytes = fread(report, 1, sizeof report - 1, f);
+    if (ferror(f) || bytes == sizeof report - 1) {
+        fclose(f);
+        return 1;
+    }
+    fclose(f);
+    report[bytes] = '\0';
+    if (!contains(report, "route,CPU_PROGRAM,1,3\n") ||
+        !contains(report, "route,DROPPED,1,1\n") ||
+        !contains(report, "backend,GPU_VERTEX_REJECTED,1,3\n") ||
+        !contains(report, "fallback,VSH_REJECTED,1,0\n") ||
+        !contains(report, "visibility,UNKNOWN,1,3\n") ||
+        !contains(report, "visibility,NOT_SUBMITTED,1,1\n") ||
+        !contains(report, "cull,SOFTWARE_TRIANGLES,1,0\n") ||
+        !contains(report, "reason,SHORT_BATCH,1,1\n") ||
+        !contains(report, "semaphore,DIRECT_RELEASE,1,0\n") ||
+        !contains(report, "clear_size,16:16,1,0\n") ||
+        !contains(report, "flip_size,16:16,1,0\n") ||
+        !contains(report, "method_seen,5:0310,1,0\n") ||
+        !contains(report, "method_unhandled,4:1D70,1,0\n"))
+        return 1;
+    return 0;
+}
