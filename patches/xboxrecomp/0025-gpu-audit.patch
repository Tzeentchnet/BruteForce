+    NV2A_AUDIT_BACKEND_COUNT
+};
+
+enum Nv2aAuditFallback {
+    NV2A_AUDIT_VSH_UNAVAILABLE,
+    NV2A_AUDIT_VSH_PREPARATION,
+    NV2A_AUDIT_VSH_REJECTED,
+    NV2A_AUDIT_FALLBACK_COUNT
