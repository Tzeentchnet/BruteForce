@@ -0,0 +1,430 @@
+#include <windows.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "video/fb_present.c"
+
+#define REQUIRE(c) do { if (!(c)) { fprintf(stderr, "FAIL %d: %s\n", __LINE__, #c); return 1; } } while (0)
+#define FRAME_VA 0x80001000u
+#define OVERLAY_AT 0x2000u
+#define W 4u
+#define H 3u
+
+static uint8_t *guest;
+static uint32_t regs[0x1000 / 4];
+static int fake_gpu, fake_shared, fake_allow, fake_legacy_calls, fake_traced_calls;
+static HRESULT fake_result = S_OK;
+static enum GpuPresentStage fake_stage = GPU_PRESENT_CALLED;
+static volatile LONG stress_done, stress_failed, aa_done;
+
+ptrdiff_t xbox_GetMemoryOffset(void) { return (ptrdiff_t)((uintptr_t)guest - 0x80000000u); }
+void xbox_InputKeySet(int vk, int down) { (void)vk; (void)down; }
+void xbox_InputKeysClear(void) {}
+int xbox_InputWin32SideVk(int vk, uint32_t l) { (void)vk; (void)l; return 0; }
+int xbox_InputWin32MouseVk(unsigned m, uint32_t w, int *d)
+{ (void)m; (void)w; (void)d; return 0; }
+void recomp_exit_hook_run(const char *why) { (void)why; }
+bool nv2a_hook_pvideo_snapshot(uint32_t *out) { memcpy(out, regs, sizeof regs); return true; }
+void nv2a_hook_pvideo_consume(unsigned bank) { regs[NV_PVIDEO_BUFFER / 4] &= ~(1u << (bank * 4)); }
+
+int gpu_present_enabled(void) { return 0; }
+int gpu_present_init(HWND hwnd, uint32_t w, uint32_t h) { (void)hwnd; (void)w; (void)h; return 0; }
+int gpu_present_active(void) { return fake_gpu; }
+void gpu_present_shutdown(void) {}
+int gpu_present_frame(const uint32_t *p, int allow, uint64_t id)
+{ (void)p; (void)allow; (void)id; ++fake_legacy_calls; return 1; }
+int gpu_present_frame_capture(const uint32_t *p, int allow, uint64_t id, GpuPresentTrace *trace)
+{
+    (void)p; (void)id;
+    ++fake_traced_calls;
+    fake_allow = allow;
+    memset(trace, 0, sizeof *trace);
+    if (fake_shared) {
+        trace->route = GPU_PRESENT_SHARED_REJECTED;
+        trace->stage = GPU_PRESENT_INCOMPATIBLE;
+        trace->shared_release = S_OK;
+    } else {
+        trace->route = fake_stage == GPU_PRESENT_CALLED ? GPU_PRESENT_CPU_UPLOAD
+                                                       : GPU_PRESENT_NO_INPUT;
+        trace->stage = fake_stage;
+        trace->result = fake_result;
+    }
+    return fake_result == S_OK;
+}
+
+static int stats_identity(const char *path, uint32_t *volume, uint64_t *index)
+{
+    BY_HANDLE_FILE_INFORMATION info;
+    HANDLE f = CreateFileA(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE,
+                           NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+    int ok;
+    if (f == INVALID_HANDLE_VALUE)
+        return 0;
+    ok = GetFileInformationByHandle(f, &info) != 0;
+    CloseHandle(f);
+    if (!ok)
+        return 0;
+    *volume = info.dwVolumeSerialNumber;
+    *index = ((uint64_t)info.nFileIndexHigh << 32) | info.nFileIndexLow;
+    return *index != 0;
+}
+
+static RecompPresentTag tag_for(uint32_t id, uint32_t volume, uint64_t index,
+                                enum RecompPresentPixels pixels)
+{
+    return recomp_present_tag(RECOMP_PRESENT_STATS_READY, id - 1, volume, index, pixels);
+}
+
+static void fill(uint32_t value)
+{
+    uint32_t *p = (uint32_t *)(guest + 0x1000);
+    unsigned i;
+    for (i = 0; i < W * H; ++i)
+        p[i] = value;
+}
+
+static void overlay(uint8_t luma)
+{
+    memset(regs, 0, sizeof regs);
+    regs[NV_PVIDEO_BUFFER / 4] = 1;
+    regs[NV_PVIDEO_OFFSET / 4] = OVERLAY_AT;
+    regs[NV_PVIDEO_LIMIT / 4] = OVERLAY_AT + 4;
+    regs[NV_PVIDEO_FORMAT / 4] = (1u << 16) | 4u;
+    regs[NV_PVIDEO_SIZE_IN / 4] = (1u << 16) | 2u;
+    regs[NV_PVIDEO_SIZE_OUT / 4] = (1u << 16) | 2u;
+    regs[NV_PVIDEO_DS_DX / 4] = 1u << 20;
+    regs[NV_PVIDEO_DT_DY / 4] = 1u << 20;
+    guest[OVERLAY_AT] = luma;
+    guest[OVERLAY_AT + 1] = 128;
+    guest[OVERLAY_AT + 2] = luma;
+    guest[OVERLAY_AT + 3] = 128;
+}
+
+static DWORD WINAPI stress_writer(LPVOID unused)
+{
+    unsigned i;
+    (void)unused;
+    for (i = 1; i <= 2000; ++i) {
+        RecompPresentTag tag = tag_for(i, 1, 1, RECOMP_PRESENT_PIXELS_CPU);
+        fill(i & 1 ? 0x00112233u : 0x00445566u);
+        xbox_FramebufferWindowPresentTagged(FRAME_VA, W * 4, &tag);
+    }
+    InterlockedExchange(&stress_done, 1);
+    return 0;
+}
+
+static int stress(void)
+{
+    HANDLE writer;
+    uint32_t out[W * H];
+    FbPresentInfo info;
+    unsigned i;
+    writer = CreateThread(NULL, 0, stress_writer, NULL, 0, NULL);
+    REQUIRE(writer != NULL);
+    do {
+        if (fb_copy_presented_frame_info(out, &info)) {
+            uint32_t expected = info.tag.flip_candidate & 1 ? 0x00112233u : 0x00445566u;
+            if (info.id != info.tag.flip_candidate)
+                InterlockedExchange(&stress_failed, 1);
+            for (i = 0; i < W * H; ++i)
+                if (out[i] != expected)
+                    InterlockedExchange(&stress_failed, 1);
+        }
+    } while (!InterlockedCompareExchange(&stress_done, 0, 0));
+    REQUIRE(WaitForSingleObject(writer, 5000) == WAIT_OBJECT_0);
+    CloseHandle(writer);
+    REQUIRE(!stress_failed);
+    puts("snapshot and provenance stress passed");
+    return 0;
+}
+
+static DWORD WINAPI stress_aa_writer(LPVOID unused)
+{
+    unsigned n = 0;
+    (void)unused;
+    while (!InterlockedCompareExchange(&aa_done, 0, 0))
+        xbox_FramebufferWindowSetAA((n++ & 1u) + 1u);
+    return 0;
+}
+
+static int stress_aa_snapshot(void)
+{
+    HANDLE writer;
+    uint32_t out[W * H];
+    FbPresentInfo info;
+    unsigned i, x, y;
+    REQUIRE(_putenv_s("RECOMP_PRESENTER_CAPTURE", "fixture") == 0);
+    for (y = 0; y < H * 2; ++y)
+        for (x = 0; x < W * 2; ++x)
+            ((uint32_t *)(guest + 0x1000))[y * W * 2 + x] = 0xff000000u | y;
+    writer = CreateThread(NULL, 0, stress_aa_writer, NULL, 0, NULL);
+    REQUIRE(writer != NULL);
+    for (i = 1; i <= 2000; ++i) {
+        RecompPresentTag tag = tag_for(i, 1, 1, RECOMP_PRESENT_PIXELS_CPU);
+        xbox_FramebufferWindowPresentTagged(FRAME_VA, W * 8, &tag);
+        REQUIRE(fb_copy_presented_frame_info(out, &info));
+        REQUIRE(info.aa_sy == 1 || info.aa_sy == 2);
+        for (y = 0; y < H; ++y)
+            for (x = 0; x < W; ++x)
+                REQUIRE(out[y * W + x] == (0xff000000u | y * info.aa_sy));
+    }
+    InterlockedExchange(&aa_done, 1);
+    REQUIRE(WaitForSingleObject(writer, 5000) == WAIT_OBJECT_0);
+    CloseHandle(writer);
+    puts("concurrent AA metadata and pixels remained coherent");
+    return 0;
+}
+
+static int setup(uint32_t **pixels, HWND *window, HDC *dc, HBITMAP *bitmap, BITMAPINFO *bi)
+{
+    BITMAPINFO target;
+    void *bits;
+    guest = (uint8_t *)VirtualAlloc(NULL, 0x10000, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+    s_fb_width = W; s_fb_height = H;
+    s_rgb = (uint32_t *)calloc(W * H, 4);
+    if (!guest || !s_rgb)
+        return 0;
+    InterlockedExchange(&s_fb_running, 1);
+    _putenv_s("RECOMP_FB_VA", "");
+    memset(bi, 0, sizeof *bi);
+    bi->bmiHeader.biSize = sizeof bi->bmiHeader;
+    bi->bmiHeader.biWidth = W;
+    bi->bmiHeader.biHeight = -(LONG)H;
+    bi->bmiHeader.biPlanes = 1;
+    bi->bmiHeader.biBitCount = 32;
+    bi->bmiHeader.biCompression = BI_RGB;
+    *window = CreateWindowA("STATIC", "synthetic presenter", WS_OVERLAPPEDWINDOW,
+                            0, 0, 200, 200, NULL, NULL, GetModuleHandleA(NULL), NULL);
+    *dc = CreateCompatibleDC(NULL);
+    memset(&target, 0, sizeof target);
+    target.bmiHeader.biSize = sizeof target.bmiHeader;
+    target.bmiHeader.biWidth = 256;
+    target.bmiHeader.biHeight = -256;
+    target.bmiHeader.biPlanes = 1;
+    target.bmiHeader.biBitCount = 32;
+    *bitmap = CreateDIBSection(*dc, &target, DIB_RGB_COLORS, &bits, NULL, 0);
+    if (!*window || !*dc || !*bitmap || !bits)
+        return 0;
+    SelectObject(*dc, *bitmap);
+    *pixels = (uint32_t *)(guest + 0x1000);
+    return 1;
+}
+
+int main(int argc, char **argv)
+{
+    HWND window;
+    HDC dc;
+    HBITMAP bitmap;
+    BITMAPINFO bi;
+    uint32_t *pixels, volume = 0;
+    uint64_t index = 0;
+    RecompPresentTag tag;
+    FbPresentInfo info;
+    unsigned i, y;
+    int overlay_ok;
+
+    if (argc < 2 || !setup(&pixels, &window, &dc, &bitmap, &bi))
+        return 2;
+    if (!strcmp(argv[1], "stress"))
+        return stress();
+    if (!strcmp(argv[1], "stress_aa"))
+        return stress_aa_snapshot();
+    if (argc != 4 || !stats_identity(argv[3], &volume, &index))
+        return 2;
+    if (!strcmp(argv[1], "collision"))
+        return recomp_capture_open(&s_capture, argv[2]) ? 1 : 0;
+    if (!strcmp(argv[1], "config_direct") || !strcmp(argv[1], "config_no_window")) {
+        REQUIRE(_putenv_s("RECOMP_PRESENTER_CAPTURE", argv[2]) == 0);
+        REQUIRE(_putenv_s("RECOMP_FB_WINDOW", !strcmp(argv[1], "config_direct") ? "1" : "") == 0);
+        REQUIRE(_putenv_s("RECOMP_GPU_DIRECT_PRESENT", "1") == 0);
+        xbox_FramebufferWindowStart();
+        return 1;
+    }
+    REQUIRE(recomp_capture_open(&s_capture, argv[2]));
+    tag = tag_for(1, volume, index, RECOMP_PRESENT_PIXELS_CPU);
+    if (!strcmp(argv[1], "occupied") || !strcmp(argv[1], "invalid_record") ||
+        !strcmp(argv[1], "close_collision")) {
+        RecompCaptureRecord record;
+        char path[RECOMP_CAPTURE_PATH];
+        HANDLE file;
+        DWORD written, got;
+        char sentinel[4] = {0};
+        memset(&record, 0, sizeof record);
+        record.start_ns = 1; record.end_ns = 2;
+        record.origin = RECOMP_CAPTURE_FLIP;
+        record.publication_id = 1;
+        record.tag = tag;
+        record.pitch = W * 4; record.bpp = 4; record.aa_sy = 1;
+        record.route = RECOMP_CAPTURE_GDI;
+        record.result = RECOMP_CAPTURE_GDI_OK;
+        record.width = W; record.height = H; record.image = s_rgb;
+        if (!strcmp(argv[1], "close_collision")) {
+            REQUIRE(recomp_capture_path(path, sizeof path, s_capture.directory, "complete.txt"));
+            file = CreateFileA(path, GENERIC_WRITE, 0, NULL, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, NULL);
+            REQUIRE(file != INVALID_HANDLE_VALUE);
+            REQUIRE(WriteFile(file, "keep", 4, &written, NULL) && written == 4 && CloseHandle(file));
+            REQUIRE(!recomp_capture_close(&s_capture, "thread_stopped"));
+            file = CreateFileA(path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING,
+                               FILE_ATTRIBUTE_NORMAL, NULL);
+            REQUIRE(file != INVALID_HANDLE_VALUE);
+            REQUIRE(ReadFile(file, sentinel, 4, &got, NULL) && got == 4 && CloseHandle(file));
+            REQUIRE(!memcmp(sentinel, "keep", 4));
+            return 0;
+        }
+        if (!strcmp(argv[1], "invalid_record")) {
+            record.pinned = 1;
+            REQUIRE(!recomp_capture_record(&s_capture, &record));
+            record.pinned = 0;
+            record.tag.pixels = RECOMP_PRESENT_PIXELS_READBACK_FAILED;
+            REQUIRE(!recomp_capture_record(&s_capture, &record));
+            record.tag = tag;
+            record.tag.stats = RECOMP_PRESENT_STATS_DISABLED;
+            REQUIRE(!recomp_capture_record(&s_capture, &record));
+            recomp_capture_abandon(&s_capture);
+            return 0;
+        }
+        REQUIRE(recomp_capture_path(path, sizeof path, s_capture.directory,
+                                    "present-00000000000000000001.bmp"));
+        file = CreateFileA(path, GENERIC_WRITE, 0, NULL, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, NULL);
+        REQUIRE(file != INVALID_HANDLE_VALUE);
+        REQUIRE(WriteFile(file, "keep", 4, &written, NULL) && written == 4 && CloseHandle(file));
+        REQUIRE(!recomp_capture_record(&s_capture, &record));
+        file = CreateFileA(path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING,
+                           FILE_ATTRIBUTE_NORMAL, NULL);
+        REQUIRE(file != INVALID_HANDLE_VALUE);
+        REQUIRE(ReadFile(file, sentinel, 4, &got, NULL) && got == 4 && CloseHandle(file));
+        REQUIRE(!memcmp(sentinel, "keep", 4));
+        recomp_capture_abandon(&s_capture);
+        return 0;
+    }
+    if (!strcmp(argv[1], "invalid_input")) {
+        DWORD old;
+        REQUIRE(VirtualProtect(guest + 0x1000, 0x1000, PAGE_NOACCESS, &old));
+        xbox_FramebufferWindowPresentTagged(FRAME_VA, W * 4, &tag);
+        return 1;
+    }
+    if (!strcmp(argv[1], "invalid_range")) {
+        xbox_FramebufferWindowPresentTagged(0x83ffffffu, W * 4, &tag);
+        return 1;
+    }
+    fill(0xff112233u);
+    xbox_FramebufferWindowPresentTagged(FRAME_VA, W * 4, &tag);
+    REQUIRE(fb_copy_presented_frame_info(s_rgb, &info));
+    if (!strcmp(argv[1], "shared")) {
+        fake_gpu = fake_shared = 1;
+        fb_show(window, dc, &bi, info.id, &info, RECOMP_CAPTURE_FLIP, 0, 0);
+        return 1;
+    }
+    if (!strcmp(argv[1], "no_client") || !strcmp(argv[1], "no_surface") ||
+        !strcmp(argv[1], "resize_failed") || !strcmp(argv[1], "target_failed") ||
+        !strcmp(argv[1], "other_status")) {
+        if (strcmp(argv[1], "no_client")) {
+            fake_gpu = 1;
+            if (!strcmp(argv[1], "no_surface"))
+                fake_stage = GPU_PRESENT_NO_SURFACE;
+            else if (!strcmp(argv[1], "resize_failed")) {
+                fake_stage = GPU_PRESENT_RESIZE_FAILED;
+                fake_result = E_FAIL;
+            } else if (!strcmp(argv[1], "target_failed"))
+                fake_stage = GPU_PRESENT_TARGET_FAILED;
+            else
+                fake_result = S_FALSE;
+        }
+        fb_show(!strcmp(argv[1], "no_client") ? NULL : window, dc, &bi, info.id, &info,
+                RECOMP_CAPTURE_FLIP, 0, 0);
+        REQUIRE(recomp_capture_close(&s_capture, "thread_stopped"));
+        return 0;
+    }
+    REQUIRE(!strcmp(argv[1], "record"));
+    REQUIRE(info.id == 1 && info.tag.flip_candidate == 1);
+    REQUIRE(fb_show(window, dc, &bi, info.id, &info, RECOMP_CAPTURE_FLIP, 0, 0) == 0);
+
+    fake_gpu = 1;
+    overlay(235);
+    REQUIRE(fb_copy_presented_frame_info(s_rgb, &info));
+    overlay_ok = fb_overlay();
+    REQUIRE(overlay_ok && s_rgb[0] == 0xffffffffu);
+    fb_show(window, dc, &bi, info.id, &info, RECOMP_CAPTURE_FLIP, 0, overlay_ok);
+    REQUIRE(!fake_allow);
+    overlay(16);
+    REQUIRE(fb_copy_presented_frame_info(s_rgb, &info));
+    overlay_ok = fb_overlay();
+    REQUIRE(overlay_ok && s_rgb[0] == 0xff000000u);
+    fb_show(window, dc, &bi, info.id, &info, RECOMP_CAPTURE_FLIP, 0, overlay_ok);
+    REQUIRE(!fake_allow);
+
+    regs[NV_PVIDEO_STOP / 4] = 1;
+    tag = tag_for(2, volume, index, RECOMP_PRESENT_PIXELS_CPU);
+    fill(0xff222222u);
+    xbox_FramebufferWindowPresentTagged(FRAME_VA, W * 4, &tag);
+    tag = tag_for(3, volume, index, RECOMP_PRESENT_PIXELS_CPU);
+    fill(0xff333333u);
+    xbox_FramebufferWindowPresentTagged(FRAME_VA, W * 4, &tag);
+    REQUIRE(fb_copy_presented_frame_info(s_rgb, &info));
+    REQUIRE(info.id == 3 && info.tag.flip_candidate == 3 && !fb_overlay());
+    fb_show(window, dc, &bi, info.id, &info, RECOMP_CAPTURE_FLIP, 0, 0);
+    REQUIRE(fake_allow);
+
+    tag = tag_for(4, volume, index, RECOMP_PRESENT_PIXELS_READBACK);
+    for (i = 0; i < W * H; ++i)
+        ((uint16_t *)pixels)[i] = 0xf800;
+    xbox_FramebufferWindowPresentTagged(FRAME_VA, W * 2, &tag);
+    REQUIRE(fb_copy_presented_frame_info(s_rgb, &info));
+    REQUIRE(info.bpp == 2 && s_rgb[0] == 0x00ff0000u);
+    fb_show(window, dc, &bi, info.id, &info, RECOMP_CAPTURE_FLIP, 0, 0);
+
+    tag = tag_for(5, volume, index, RECOMP_PRESENT_PIXELS_CPU);
+    xbox_FramebufferWindowSetAA(2);
+    for (y = 0; y < H * 2; ++y)
+        for (i = 0; i < W * 2; ++i)
+            pixels[y * W * 2 + i] = !(y & 1) && !(i & 1) ? 0x00123456u : 0x00abcdefu;
+    xbox_FramebufferWindowPresentTagged(FRAME_VA, W * 8, &tag);
+    REQUIRE(fb_copy_presented_frame_info(s_rgb, &info));
+    REQUIRE(info.bpp == 8 && info.aa_sy == 2 && s_rgb[0] == 0x00123456u);
+    fb_show(window, dc, &bi, info.id, &info, RECOMP_CAPTURE_FLIP, 0, 0);
+    fake_result = DXGI_STATUS_OCCLUDED;
+    fb_show(window, dc, &bi, info.id, &info, RECOMP_CAPTURE_FLIP, 0, 0);
+    fake_result = E_FAIL;
+    fb_show(window, dc, &bi, info.id, &info, RECOMP_CAPTURE_FLIP, 0, 0);
+    fake_result = S_OK;
+    fake_gpu = 0;
+    fb_show(window, NULL, &bi, info.id, &info, RECOMP_CAPTURE_FLIP, 0, 0);
+
+    xbox_FramebufferWindowSetAA(1);
+    xbox_FramebufferWindowPresentTagged(FRAME_VA, W * 3, &tag);
+    REQUIRE(fb_copy_presented_frame_info(s_rgb, &info));
+    REQUIRE(info.bpp == 3 && s_rgb[0] == 0);
+    fb_show(window, dc, &bi, info.id, &info, RECOMP_CAPTURE_FLIP, 0, 0);
+    tag = recomp_present_tag(RECOMP_PRESENT_STATS_DISABLED, 0, 0, 0, RECOMP_PRESENT_PIXELS_CPU);
+    fill(0xff777777u);
+    xbox_FramebufferWindowPresentTagged(FRAME_VA, W * 4, &tag);
+    REQUIRE(fb_copy_presented_frame_info(s_rgb, &info));
+    fb_show(window, dc, &bi, info.id, &info, RECOMP_CAPTURE_FLIP, 0, 0);
+    tag = tag_for(6, volume, index, RECOMP_PRESENT_PIXELS_READBACK_FAILED);
+    xbox_FramebufferWindowPresentTagged(FRAME_VA, W * 4, &tag);
+    REQUIRE(fb_copy_presented_frame_info(s_rgb, &info));
+    fb_show(window, dc, &bi, info.id, &info, RECOMP_CAPTURE_FLIP, 0, 0);
+    tag = tag_for(7, volume, index, RECOMP_PRESENT_PIXELS_READBACK_UNAVAILABLE);
+    xbox_FramebufferWindowPresentTagged(FRAME_VA, W * 4, &tag);
+    REQUIRE(fb_copy_presented_frame_info(s_rgb, &info));
+    fb_show(window, dc, &bi, info.id, &info, RECOMP_CAPTURE_FLIP, 0, 0);
+    tag = recomp_present_tag(RECOMP_PRESENT_STATS_NO_ID, 4, 0, 0, RECOMP_PRESENT_PIXELS_CPU);
+    xbox_FramebufferWindowPresentTagged(FRAME_VA, W * 4, &tag);
+    REQUIRE(fb_copy_presented_frame_info(s_rgb, &info));
+    fb_show(window, dc, &bi, info.id, &info, RECOMP_CAPTURE_FLIP, 0, 0);
+    memset(&info, 0, sizeof info);
+    info.pitch = W * 4; info.bpp = 4; info.aa_sy = 1;
+    REQUIRE(_putenv_s("RECOMP_FB_VA", "1") == 0);
+    fb_show(window, dc, &bi, 0, &info, RECOMP_CAPTURE_PINNED, 1, 0);
+    REQUIRE(_putenv_s("RECOMP_FB_VA", "") == 0);
+    fb_show(window, dc, &bi, 0, &info, RECOMP_CAPTURE_FALLBACK, 0, 0);
+    fb_capture_missing_input(0);
+    REQUIRE(recomp_capture_close(&s_capture, "thread_stopped"));
+    fake_gpu = 1;
+    REQUIRE(fb_show(window, dc, &bi, 0, &info, RECOMP_CAPTURE_FALLBACK, 0, 0) == 1);
+    REQUIRE(fake_legacy_calls == 1 && fake_traced_calls > 0);
+    puts("presenter input capture passed");
+    return 0;
+}
