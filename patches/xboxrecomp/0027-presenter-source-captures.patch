+void recomp_exit_hook_run(const char *why) { (void)why; }
+bool nv2a_hook_pvideo_snapshot(uint32_t *regs) { (void)regs; return false; }
+void nv2a_hook_pvideo_consume(unsigned bank) { (void)bank; }
+
+int main(int argc, char **argv)
+{
+    HWND window;
+    HDC dc;
+    HANDLE stats;
+    BY_HANDLE_FILE_INFORMATION id;
+    BITMAPINFO bi;
+    uint32_t source[64], x, y;
+    uint64_t index;
+    RecompPresentTag tag;
+    FbPresentInfo info;
+    ID3D11Texture2D *staging = NULL;
+    D3D11_TEXTURE2D_DESC td;
+    D3D11_MAPPED_SUBRESOURCE mapped;
+
+    if (argc != 3)
+        return 2;
+    _putenv_s("RECOMP_FB_VA", "");
+    _putenv_s("RECOMP_PRESENT_VSYNC", "0");
+    stats = CreateFileA(argv[2], GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
+                        OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+    REQUIRE(stats != INVALID_HANDLE_VALUE && GetFileInformationByHandle(stats, &id));
+    REQUIRE(CloseHandle(stats));
+    index = ((uint64_t)id.nFileIndexHigh << 32) | id.nFileIndexLow;
+    REQUIRE(index != 0);
+    window = CreateWindowA("STATIC", "synthetic D3D presenter", WS_OVERLAPPEDWINDOW,
+                           0, 0, 200, 200, NULL, NULL, GetModuleHandleA(NULL), NULL);
+    REQUIRE(window != NULL);
+    dc = GetDC(window);
+    REQUIRE(dc != NULL);
+    guest = (uint8_t *)VirtualAlloc(NULL, 0x10000, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+    REQUIRE(guest != NULL);
+    s_fb_width = s_fb_height = 8;
+    s_rgb = (uint32_t *)calloc(64, 4);
+    REQUIRE(s_rgb != NULL);
+    InterlockedExchange(&s_fb_running, 1);
+    memset(&bi, 0, sizeof bi);
+    bi.bmiHeader.biSize = sizeof bi.bmiHeader;
+    bi.bmiHeader.biWidth = 8; bi.bmiHeader.biHeight = -8;
+    bi.bmiHeader.biPlanes = 1; bi.bmiHeader.biBitCount = 32;
+    REQUIRE(gpu_present_init(window, 8, 8));
+    REQUIRE(recomp_capture_open(&s_capture, argv[1]));
+    for (x = 0; x < 64; ++x)
+        source[x] = 0xff000000u | x * 0x00010203u;
+    memcpy(guest + 0x1000, source, sizeof source);
+    tag = recomp_present_tag(RECOMP_PRESENT_STATS_READY, 0, id.dwVolumeSerialNumber, index,
+                             RECOMP_PRESENT_PIXELS_CPU);
+    xbox_FramebufferWindowPresentTagged(0x80001000u, 8 * 4, &tag);
+    REQUIRE(fb_copy_presented_frame_info(s_rgb, &info));
+    fb_show(window, dc, &bi, info.id, &info, RECOMP_CAPTURE_FLIP, 0, 0);
+    memset(&td, 0, sizeof td);
+    td.Width = td.Height = 8; td.MipLevels = td.ArraySize = 1;
+    td.Format = DXGI_FORMAT_B8G8R8A8_UNORM; td.SampleDesc.Count = 1;
+    td.Usage = D3D11_USAGE_STAGING; td.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    REQUIRE(SUCCEEDED(ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &staging)));
+    ID3D11DeviceContext_CopyResource(s_ctx, (ID3D11Resource *)staging, (ID3D11Resource *)s_frame);
+    REQUIRE(SUCCEEDED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)staging, 0,
+                                             D3D11_MAP_READ, 0, &mapped)));
+    for (y = 0; y < 8; ++y)
+        for (x = 0; x < 8; ++x)
+            REQUIRE(((const uint32_t *)((const uint8_t *)mapped.pData + y * mapped.RowPitch))[x]
+                    == source[y * 8 + x]);
+    ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)staging, 0);
+    ID3D11Texture2D_Release(staging);
+    REQUIRE(recomp_capture_close(&s_capture, "thread_stopped"));
+    gpu_present_shutdown();
+    ReleaseDC(window, dc);
+    DestroyWindow(window);
+    puts("real D3D presenter input matches captured CPU bytes");
+    return 0;
+}
diff --git a/tests/presenter_capture/run_windows.ps1 b/tests/presenter_capture/run_windows.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..305c6baf2d4233863ae023ab690538a6e5e97fb4
--- /dev/null
+++ b/tests/presenter_capture/run_windows.ps1
@@ -0,0 +1,85 @@
+param(
+    [string] $BuildDirectory = "",
+    [string] $ProjectTests = "",
+    [switch] $SkipHardware
+)
+
+$ErrorActionPreference = "Stop"
+$root = (Resolve-Path (Join-Path $PSScriptRoot "..\..")).Path
+if (-not $BuildDirectory) {
+    $BuildDirectory = Join-Path $root "build-presenter-capture"
+}
+$BuildDirectory = [IO.Path]::GetFullPath($BuildDirectory)
+if (-not $BuildDirectory.StartsWith($root + "\", [StringComparison]::OrdinalIgnoreCase)) {
+    throw "BuildDirectory must be inside the exported toolkit tree."
+}
+foreach ($tool in @("cl.exe", "link.exe", "python.exe")) {
+    if (-not (Get-Command $tool -ErrorAction SilentlyContinue)) {
+        throw "$tool is missing; run from a VS 2022 x64 developer environment with Python 3."
+    }
+}
+New-Item -ItemType Directory -Force -Path $BuildDirectory | Out-Null
+$includes = @(
+    "/I$(Join-Path $root 'src')",
+    "/I$(Join-Path $root 'src\kernel')",
+    "/I$(Join-Path $root 'src\input')",
+    "/I$(Join-Path $root 'src\nv2a')",
+    "/I$(Join-Path $root 'src\platform')"
+)
+$compile = @("/nologo", "/O2", "/std:c11") + $includes
+$gpuLibs = @("user32.lib", "d3d11.lib", "dxgi.lib", "dxguid.lib", "d3dcompiler.lib")
+
+function Invoke-Checked([string] $exe, [string[]] $arguments) {
+    & $exe @arguments
+    if ($LASTEXITCODE -ne 0) { throw "$exe failed with exit code $LASTEXITCODE" }
+}
+
+$oldBin = $env:PRESCAP_TEST_BIN_DIR
+$oldLegacy = $env:PRESCAP_TEST_HAVE_LEGACY
+$oldSkip = $env:PRESCAP_TEST_SKIP_HARDWARE
+Push-Location $BuildDirectory
+try {
+    Invoke-Checked "cl.exe" ($compile + @(
+        (Join-Path $PSScriptRoot "presenter_capture_test.c"),
+        "/Fe:presenter_capture_test.exe", "user32.lib", "gdi32.lib"))
+    Invoke-Checked "cl.exe" ($compile + @(
+        (Join-Path $PSScriptRoot "shared_gpu_capture_test.c"),
+        "/Fe:shared_gpu_capture_test.exe") + $gpuLibs)
+    Invoke-Checked "cl.exe" ($compile + @(
+        (Join-Path $PSScriptRoot "real_presenter_test.c"),
+        "/Fe:real_presenter_test.exe", "gdi32.lib") + $gpuLibs)
+    $executorSources = @((Join-Path $PSScriptRoot "executor_capture_test.c"))
+    foreach ($name in @("nv2a_pb_exec", "nv2a_census", "nv2a_combiner", "nv2a_flip_hold",
+                        "nv2a_frame_stats", "nv2a_gpu_audit", "nv2a_vsh_interp")) {
+        $executorSources += Join-Path $root "src\kernel\$name.c"
+    }
+    Invoke-Checked "cl.exe" ($compile + @("/Gy", "/c") + $executorSources)
+    Invoke-Checked "link.exe" @(
+        "/nologo", "/opt:ref", "/out:executor_capture_test.exe",
+        "executor_capture_test.obj", "nv2a_pb_exec.obj", "nv2a_census.obj",
+        "nv2a_combiner.obj", "nv2a_flip_hold.obj", "nv2a_frame_stats.obj",
+        "nv2a_gpu_audit.obj", "nv2a_vsh_interp.obj")
+    $env:PRESCAP_TEST_HAVE_LEGACY = ""
+    if ($ProjectTests) {
+        $present = Join-Path $ProjectTests "present_test.c"
+        $shared = Join-Path $ProjectTests "gpu_shared_present_test.c"
+        if (-not (Test-Path $present -PathType Leaf) -or -not (Test-Path $shared -PathType Leaf)) {
+            throw "ProjectTests must contain present_test.c and gpu_shared_present_test.c."
+        }
+        Invoke-Checked "cl.exe" ($compile + @(
+            $present, (Join-Path $PSScriptRoot "legacy_stubs.c"),
+            "/Fe:legacy_present_test.exe", "user32.lib", "gdi32.lib"))
+        Invoke-Checked "cl.exe" ($compile + @(
+            $shared, "/Fe:legacy_shared_test.exe") + $gpuLibs)
+        $env:PRESCAP_TEST_HAVE_LEGACY = "1"
+    }
+    $env:PRESCAP_TEST_BIN_DIR = $BuildDirectory
+    $env:PRESCAP_TEST_SKIP_HARDWARE = if ($SkipHardware) { "1" } else { "" }
+    Invoke-Checked "python.exe" @("-B", (Join-Path $PSScriptRoot "test_present_capture.py"))
+}
+finally {
+    $env:PRESCAP_TEST_BIN_DIR = $oldBin
+    $env:PRESCAP_TEST_HAVE_LEGACY = $oldLegacy
+    $env:PRESCAP_TEST_SKIP_HARDWARE = $oldSkip
+    Pop-Location
+}
diff --git a/tests/presenter_capture/shared_gpu_capture_test.c b/tests/presenter_capture/shared_gpu_capture_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..71f1ff88a91e748ac6e919f481d04030e0814567
--- /dev/null
+++ b/tests/presenter_capture/shared_gpu_capture_test.c
@@ -0,0 +1,162 @@
+#define COBJMACROS
+#include <windows.h>
+#include <d3d11.h>
+#include <dxgi.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "video/gpu_present.c"
+
+#define REQUIRE(c) do { if (!(c)) { fprintf(stderr, "FAIL %d: %s\n", __LINE__, #c); return 1; } } while (0)
+
+static int shared_test(HWND window, D3D_DRIVER_TYPE driver)
+{
+    D3D_FEATURE_LEVEL feature = D3D_FEATURE_LEVEL_11_0, obtained;
+    ID3D11Device *producer = NULL;
+    ID3D11DeviceContext *producer_ctx = NULL;
+    ID3D11Texture2D *texture = NULL, *target = NULL, *staging = NULL;
+    IDXGIResource *resource = NULL;
+    IDXGIKeyedMutex *mutex = NULL;
+    ID3D11ShaderResourceView *view;
+    D3D11_TEXTURE2D_DESC td;
+    D3D11_MAPPED_SUBRESOURCE mapped;
+    GpuPresentTrace trace;
+    HANDLE handle = NULL;
+    uint32_t source[64], cpu[64], x, y;
+    int held;
+    HRESULT hr;
+
+    REQUIRE(SUCCEEDED(D3D11CreateDevice(NULL, driver, NULL, 0, &feature, 1,
+                                       D3D11_SDK_VERSION, &producer, &obtained, &producer_ctx)));
+    REQUIRE(SUCCEEDED(D3D11CreateDevice(NULL, driver, NULL, 0, &feature, 1,
+                                       D3D11_SDK_VERSION, &s_dev, &obtained, &s_ctx)));
+    memset(&td, 0, sizeof td);
+    td.Width = td.Height = 8;
+    td.MipLevels = td.ArraySize = 1;
+    td.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    td.SampleDesc.Count = 1;
+    td.Usage = D3D11_USAGE_DEFAULT;
+    td.BindFlags = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET;
+    td.MiscFlags = D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX;
+    REQUIRE(SUCCEEDED(ID3D11Device_CreateTexture2D(producer, &td, NULL, &texture)));
+    REQUIRE(SUCCEEDED(ID3D11Texture2D_QueryInterface(texture, &IID_IDXGIResource, (void **)&resource)));
+    REQUIRE(SUCCEEDED(IDXGIResource_GetSharedHandle(resource, &handle)) && handle);
+    REQUIRE(SUCCEEDED(ID3D11Texture2D_QueryInterface(texture, &IID_IDXGIKeyedMutex, (void **)&mutex)));
+    td.MiscFlags = 0;
+    REQUIRE(SUCCEEDED(ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &target)));
+    REQUIRE(SUCCEEDED(ID3D11Device_CreateRenderTargetView(s_dev, (ID3D11Resource *)target, NULL, &s_rtv)));
+    s_hwnd = window;
+    s_w = s_h = 8;
+    client_size(&s_bw, &s_bh);
+    InterlockedExchange(&s_shared_ready, 1);
+    for (x = 0; x < 64; ++x) {
+        source[x] = 0xff000000u | x * 0x00010203u;
+        cpu[x] = 0xffeeeeeeu;
+    }
+    REQUIRE(IDXGIKeyedMutex_AcquireSync(mutex, 0, 0) == S_OK);
+    ID3D11DeviceContext_UpdateSubresource(producer_ctx, (ID3D11Resource *)texture, 0, NULL,
+                                         source, 8 * 4, 0);
+    ID3D11DeviceContext_Flush(producer_ctx);
+    REQUIRE(SUCCEEDED(IDXGIKeyedMutex_ReleaseSync(mutex, 1)));
+    REQUIRE(IDXGIKeyedMutex_AcquireSync(mutex, 1, 5000) == S_OK);
+    REQUIRE(SUCCEEDED(IDXGIKeyedMutex_ReleaseSync(mutex, 1)));
+    REQUIRE(gpu_present_submit_shared(handle, 8, 8, 42));
+    REQUIRE(!gpu_present_frame_capture(cpu, 1, 42, &trace));
+    REQUIRE(trace.route == GPU_PRESENT_SHARED_REJECTED &&
+            trace.stage == GPU_PRESENT_INCOMPATIBLE && trace.shared_release == S_OK);
+    REQUIRE(IDXGIKeyedMutex_AcquireSync(mutex, 0, 5000) == S_OK);
+    REQUIRE(SUCCEEDED(IDXGIKeyedMutex_ReleaseSync(mutex, 1)));
+
+    /* With capture off, the same protocol still selects the shared texture. */
+    REQUIRE(gpu_present_submit_shared(handle, 8, 8, 43));
+    view = take_shared(1, 43, &held);
+    REQUIRE(view && held);
+    memset(&td, 0, sizeof td);
+    td.Width = td.Height = 8;
+    td.MipLevels = td.ArraySize = 1;
+    td.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    td.SampleDesc.Count = 1;
+    td.Usage = D3D11_USAGE_STAGING;
+    td.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    REQUIRE(SUCCEEDED(ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &staging)));
+    ID3D11DeviceContext_CopyResource(s_ctx, (ID3D11Resource *)staging,
+                                     (ID3D11Resource *)s_shared_texture);
+    hr = ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)staging, 0, D3D11_MAP_READ, 0, &mapped);
+    REQUIRE(SUCCEEDED(hr));
+    for (y = 0; y < 8; ++y)
+        for (x = 0; x < 8; ++x)
+            REQUIRE(((const uint32_t *)((const uint8_t *)mapped.pData + y * mapped.RowPitch))[x]
+                    == source[y * 8 + x]);
+    ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)staging, 0);
+    ID3D11DeviceContext_Flush(s_ctx);
+    REQUIRE(SUCCEEDED(IDXGIKeyedMutex_ReleaseSync(s_shared_mutex, 0)));
+    ID3D11Texture2D_Release(staging);
+    ID3D11Texture2D_Release(target);
+    IDXGIKeyedMutex_Release(mutex);
+    IDXGIResource_Release(resource);
+    ID3D11Texture2D_Release(texture);
+    ID3D11DeviceContext_Release(producer_ctx);
+    ID3D11Device_Release(producer);
+    gpu_present_shutdown();
+    puts("shared route rejection and default ownership passed");
+    return 0;
+}
+
+static int cpu_test(HWND window)
+{
+    uint32_t source[64], x, y;
+    ID3D11Texture2D *staging = NULL;
+    D3D11_TEXTURE2D_DESC td;
+    D3D11_MAPPED_SUBRESOURCE mapped;
+    GpuPresentTrace trace;
+
+    _putenv_s("RECOMP_PRESENT_VSYNC", "0");
+    REQUIRE(gpu_present_init(window, 8, 8));
+    for (x = 0; x < 64; ++x)
+        source[x] = 0xff000000u | x * 0x00010203u;
+    gpu_present_frame_capture(source, 0, 1, &trace);
+    REQUIRE(trace.route == GPU_PRESENT_CPU_UPLOAD && trace.stage == GPU_PRESENT_CALLED);
+    memset(&td, 0, sizeof td);
+    td.Width = td.Height = 8;
+    td.MipLevels = td.ArraySize = 1;
+    td.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    td.SampleDesc.Count = 1;
+    td.Usage = D3D11_USAGE_STAGING;
+    td.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    REQUIRE(SUCCEEDED(ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &staging)));
+    ID3D11DeviceContext_CopyResource(s_ctx, (ID3D11Resource *)staging, (ID3D11Resource *)s_frame);
+    REQUIRE(SUCCEEDED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)staging, 0,
+                                             D3D11_MAP_READ, 0, &mapped)));
+    for (y = 0; y < 8; ++y)
+        for (x = 0; x < 8; ++x)
+            REQUIRE(((const uint32_t *)((const uint8_t *)mapped.pData + y * mapped.RowPitch))[x]
+                    == source[y * 8 + x]);
+    ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)staging, 0);
+    ID3D11Texture2D_Release(staging);
+    printf("D3D CPU upload passed; Present HRESULT=0x%08lX\n", (unsigned long)trace.result);
+    gpu_present_shutdown();
+    return 0;
+}
+
+int main(int argc, char **argv)
+{
+    HWND window;
+    int result;
+    if (argc != 2)
+        return 2;
+    _putenv_s("RECOMP_FB_VA", "");
+    window = CreateWindowA("STATIC", "synthetic GPU presenter", WS_OVERLAPPEDWINDOW,
+                           0, 0, 200, 200, NULL, NULL, GetModuleHandleA(NULL), NULL);
+    if (!window)
+        return 2;
+    if (!strcmp(argv[1], "cpu"))
+        result = cpu_test(window);
+    else if (!strcmp(argv[1], "warp") || !strcmp(argv[1], "hardware"))
+        result = shared_test(window, !strcmp(argv[1], "warp") ? D3D_DRIVER_TYPE_WARP
+                                                               : D3D_DRIVER_TYPE_HARDWARE);
+    else
+        result = 2;
+    DestroyWindow(window);
+    return result;
+}
diff --git a/tests/presenter_capture/test_present_capture.py b/tests/presenter_capture/test_present_capture.py
new file mode 100644
index 0000000000000000000000000000000000000000..241f99b45c3496d72509bf4910bc3ccaebae57c4
--- /dev/null
+++ b/tests/presenter_capture/test_present_capture.py
@@ -0,0 +1,328 @@
+"""Windows synthetic coverage; all generated files stay in the supplied build directory."""
+
+import csv
+import importlib.util
+import os
+from pathlib import Path
+import shutil
+import struct
+import subprocess
+import unittest
+import uuid
+
+
+ROOT = Path(__file__).resolve().parents[2]
+SPEC = importlib.util.spec_from_file_location(
+    "validate_present_capture", ROOT / "tools" / "validate_present_capture.py"
+)
+VERIFIER = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(VERIFIER)
+
+
+class PresenterCaptureTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        if os.name != "nt":
+            raise unittest.SkipTest("the prototype requires Windows")
+        cls.bin = Path(os.environ["PRESCAP_TEST_BIN_DIR"]).resolve(strict=True)
+        cls.work = cls.bin / ("run-" + uuid.uuid4().hex[:8])
+        cls.work.mkdir()
+        cls.env = {k: v for k, v in os.environ.items() if not k.upper().startswith("RECOMP_")}
+        cls.env["PYTHONDONTWRITEBYTECODE"] = "1"
+        try:
+            cls.stats = cls.work / "stats.csv"
+            cls.capture = cls.work / "capture"
+            cls.run_exe("executor_capture_test", "cpu", cls.stats)
+            cls.run_exe("presenter_capture_test", "record", cls.capture, cls.stats)
+        except Exception:
+            shutil.rmtree(cls.work)
+            raise
+
+    @classmethod
+    def tearDownClass(cls):
+        shutil.rmtree(cls.work)
+
+    @classmethod
+    def run_exe(cls, exe, *args, succeeds=True):
+        result = subprocess.run(
+            [str(cls.bin / (exe + ".exe")), *(str(arg) for arg in args)],
+            cwd=cls.work, env=cls.env, capture_output=True, text=True,
+            encoding="utf-8", errors="replace", timeout=45,
+        )
+        if (result.returncode == 0) != succeeds:
+            raise AssertionError(
+                f"{exe} {args} exited {result.returncode}\n{result.stdout}\n{result.stderr}"
+            )
+        return result
+
+    def copy_capture(self):
+        destination = self.work / ("c" + uuid.uuid4().hex[:8])
+        shutil.copytree(self.capture, destination)
+        return destination
+
+    def new_stats_and_capture(self):
+        name = uuid.uuid4().hex[:8]
+        stats = self.work / ("s" + name + ".csv")
+        capture = self.work / ("c" + name)
+        self.run_exe("executor_capture_test", "cpu", stats)
+        self.run_exe("presenter_capture_test", "record", capture, stats)
+        return stats, capture
+
+    @staticmethod
+    def update_csv(path, change):
+        with path.open(encoding="ascii", newline="") as file:
+            reader = csv.DictReader(file)
+            fields, rows = reader.fieldnames, list(reader)
+        change(rows)
+        with path.open("w", encoding="ascii", newline="") as file:
+            writer = csv.DictWriter(file, fieldnames=fields, lineterminator="\n")
+            writer.writeheader()
+            writer.writerows(rows)
+
+    @staticmethod
+    def first_pixel(directory, sequence):
+        data = (directory / f"present-{sequence:020d}.bmp").read_bytes()
+        if data[:2] != b"BM" or struct.unpack_from("<ii", data, 18) != (4, -3):
+            raise AssertionError("wrong synthetic BMP dimensions")
+        return tuple(data[54:58])
+
+    def test_flip_mapping_repeat_skip_formats_and_overlay_pixels(self):
+        result = VERIFIER.validate(self.capture, self.stats)["records"]
+        linked = [row for row in result if row["flip_link_verified"]]
+        self.assertEqual(len(result), 17)
+        self.assertEqual([row["flip_candidate"] for row in linked], [1, 1, 1, 3, 4, 5])
+        self.assertEqual([row["publication_id"] for row in linked], [1, 1, 1, 3, 4, 5])
+        self.assertEqual([row["route"] for row in linked], ["gdi"] + ["d3d_cpu"] * 5)
+        self.assertEqual([row["overlay"] for row in linked], [False, True, True, False, False, False])
+        self.assertEqual(
+            [self.first_pixel(self.capture, n) for n in range(1, 7)],
+            [(0x33, 0x22, 0x11, 0xff), (0xff, 0xff, 0xff, 0xff),
+             (0, 0, 0, 0xff), (0x33, 0x33, 0x33, 0xff),
+             (0, 0, 0xff, 0), (0x56, 0x34, 0x12, 0)],
+        )
+        ledger = VERIFIER._csv((self.capture / "submissions.csv").read_bytes(), VERIFIER.FIELDS)
+        self.assertEqual([row["format"] for row in ledger[:6]],
+                         ["xrgb8888"] * 4 + ["rgb565", "aa2x32"])
+        self.assertEqual(ledger[4]["pixels"], "readback")
+        self.assertEqual(ledger[5]["aa_sy"], "2")
+
+    def test_failed_or_untrackable_cases_are_not_aligned(self):
+        rows = VERIFIER.validate(self.capture, self.stats)["records"]
+        expected = {
+            7: "d3d_occluded", 8: "d3d_failed", 9: "gdi_failed",
+            10: "unsupported_format", 11: "statistics_disabled",
+            12: "pixels_readback_failed", 13: "pixels_readback_unavailable",
+            14: "statistics_no_identity", 15: "pinned",
+            16: "no_flip_snapshot", 17: "no_input",
