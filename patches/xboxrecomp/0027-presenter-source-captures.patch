diff --git a/tests/presenter_capture/executor_capture_test.c b/tests/presenter_capture/executor_capture_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..a83f3f414d64ecda405c871c4ebba207d50fdfe4
--- /dev/null
+++ b/tests/presenter_capture/executor_capture_test.c
@@ -0,0 +1,124 @@
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <crtdbg.h>
+#include "nv2a_backend.h"
+#include "nv2a_backend_ext.h"
+#include "video/present_provenance.h"
+
+#define REQUIRE(c) do { if (!(c)) { fprintf(stderr, "FAIL %d: %s\n", __LINE__, #c); return 1; } } while (0)
+
+static uint8_t memory[0x10000];
+static RecompPresentTag seen[8];
+static int tagged, legacy, readback_ok;
+
+ptrdiff_t xbox_GetMemoryOffset(void) { return (ptrdiff_t)memory; }
+uint32_t g_xbox_image_lo, g_xbox_image_hi, g_xbox_stack_base, g_xbox_stack_size;
+uint32_t xbox_ContiguousAllocatedBytes(void) { return 0; }
+void xbox_FramebufferWindowSet(uint32_t va, uint32_t pitch) { (void)va; (void)pitch; }
+void xbox_FramebufferWindowSetAA(uint32_t sy) { (void)sy; }
+void xbox_FramebufferWindowStart(void) {}
+void xbox_FramebufferWindowFrameStats(uint32_t draws) { (void)draws; }
+void xbox_FramebufferWindowPresent(uint32_t va, uint32_t pitch)
+{ (void)va; (void)pitch; ++legacy; }
+void xbox_FramebufferWindowPresentTagged(uint32_t va, uint32_t pitch,
+                                         const RecompPresentTag *tag)
+{
+    (void)va; (void)pitch;
+    if (tagged < 8)
+        seen[tagged] = *tag;
+    ++tagged;
+}
+void xbox_Nv2aFrameCounterFlip(void) {}
+uint32_t xbox_Nv2aFenceWordVa(void) { return 0; }
+int nv2a_pb_dma_walk(void) { return 1; }
+int xbox_Nv2aGraphSoftwareTrap(uint32_t c, uint32_t m, uint32_t d)
+{ (void)c; (void)m; (void)d; return 0; }
+int nv2a_pb_scan_in_call(void) { return 0; }
+uint32_t xbox_VblankCount(void) { return 0; }
+uint64_t xbox_HostNowNs(void) { static uint64_t n; return n += 1000000; }
+uint32_t xbox_Nv2aFrameCountersOwned(void) { return 0; }
+volatile uint32_t *xbox_Nv2aRegPtr(uint32_t offset) { (void)offset; return NULL; }
+
+static void draw(const Nv2aSurface *s, const Nv2aBatch *b) { (void)s; (void)b; }
+static int readback(uint32_t va) { (void)va; return readback_ok; }
+static const Nv2aBackend backend = {NULL, draw, NULL};
+static Nv2aBackendExt extended;
+extern void nv2a_pb_exec_method(uint32_t subch, uint32_t method, uint32_t param);
+extern void nv2a_pb_exec_report(void);
+
+static void method(uint32_t m, uint32_t p) { nv2a_pb_exec_method(0, m, p); }
+static void flip(void) { method(0x0130, 0); }
+
+int main(int argc, char **argv)
+{
+    const char *mode;
+    unsigned i;
+    _set_abort_behavior(0, _WRITE_ABORT_MSG | _CALL_REPORTFAULT);
+    if (argc != 3)
+        return 2;
+    mode = argv[1];
+    {
+        RecompPresentTag overflow = recomp_present_tag(RECOMP_PRESENT_STATS_READY, UINT32_MAX,
+                                                        12, 34, RECOMP_PRESENT_PIXELS_CPU);
+        REQUIRE(overflow.stats == RECOMP_PRESENT_STATS_EXHAUSTED &&
+                !overflow.flip_candidate && !overflow.stats_volume && !overflow.stats_file_index);
+    }
+    REQUIRE(_putenv_s("RECOMP_PRESENTER_CAPTURE", strcmp(mode, "disabled") ? "fixture" : "") == 0);
+    REQUIRE(_putenv_s("RECOMP_FRAME_STATS", strcmp(argv[2], "-") ? argv[2] : "") == 0);
+    REQUIRE(_putenv_s("RECOMP_FB_DUMP_FLIP_ID", "") == 0);
+    if (!strcmp(mode, "readback") || !strcmp(mode, "readback_failed") ||
+        !strcmp(mode, "readback_unavailable")) {
+        nv2a_backend_register(&backend);
+        if (strcmp(mode, "readback_unavailable")) {
+            extended.readback = readback;
+            nv2a_backend_ext_register(&extended);
+        }
+        readback_ok = !strcmp(mode, "readback");
+    }
+    memset(memory + 0x1000, 0x5a, 64);
+    method(0x0208, 8);
+    method(0x0200, 2u << 16);
+    method(0x0204, 2u << 16);
+    method(0x020C, 8);
+    method(0x0210, !strcmp(mode, "missing") ? 0 : 0x1000);
+    if (!strcmp(mode, "missing")) {
+        flip();
+        REQUIRE(tagged == 0 && legacy == 0);
+        method(0x0210, 0x1000);
+    }
+    for (i = 0; i < 5; ++i)
+        flip();
+    nv2a_pb_exec_report();
+    if (!strcmp(mode, "disabled")) {
+        REQUIRE(legacy == 5 && tagged == 0);
+    } else {
+        REQUIRE(tagged == 5 && legacy == 0);
+        for (i = 0; i < 5; ++i) {
+            if (!strcmp(mode, "nostats")) {
+                REQUIRE(seen[i].stats == RECOMP_PRESENT_STATS_DISABLED);
+                REQUIRE(seen[i].flip_candidate == 0);
+            } else {
+                REQUIRE(seen[i].stats == RECOMP_PRESENT_STATS_READY);
+                REQUIRE(seen[i].stats_file_index != 0);
+                if (!strcmp(mode, "readback_failed")) {
+                    REQUIRE(seen[i].pixels == RECOMP_PRESENT_PIXELS_READBACK_FAILED);
+                    REQUIRE(seen[i].flip_candidate == 0);
+                } else if (!strcmp(mode, "readback_unavailable")) {
+                    REQUIRE(seen[i].pixels == RECOMP_PRESENT_PIXELS_READBACK_UNAVAILABLE);
+                    REQUIRE(seen[i].flip_candidate == 0);
+                } else {
+                    REQUIRE(seen[i].flip_candidate == i + 1 + !strcmp(mode, "missing"));
+                    REQUIRE(seen[i].pixels == (!strcmp(mode, "readback")
+                            ? RECOMP_PRESENT_PIXELS_READBACK : RECOMP_PRESENT_PIXELS_CPU));
+                }
+                REQUIRE(seen[i].stats_file_index == seen[0].stats_file_index);
+                REQUIRE(seen[i].stats_volume == seen[0].stats_volume);
+            }
+        }
+    }
+    puts("executor provenance passed");
+    return 0;
+}
