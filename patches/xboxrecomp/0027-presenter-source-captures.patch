+#!/usr/bin/env python3
+"""Verify presenter-to-flip links, not visibility, scanout, or world FPS."""
+
+import argparse
+import csv
+import ctypes
+import io
+import json
+import os
+from pathlib import Path
+import re
+import struct
+import sys
+
+
+FIELDS = (
+    "sequence,start_ns,end_ns,origin,publication_id,flip_candidate,stats,"
+    "stats_volume,stats_file_index,pixels,format,pitch,aa_sy,overlay,pinned,"
+    "route,status,detail,width,height,image,image_fnv64"
+).split(",")
+STATS_FIELDS = "flip,t_us,draws,program_vertices,hash,distinct,constants".split(",")
+ROUTES = {
+    "none": {"no_input"},
+    "gdi": {"gdi_no_client", "gdi_ok", "gdi_failed"},
+    "d3d_cpu": {
+        "d3d_no_surface", "d3d_resize_failed", "d3d_target_failed",
+        "d3d_ok", "d3d_occluded", "d3d_failed", "d3d_other_status",
+    },
+    "d3d_shared_rejected": {"shared_rejected"},
+}
+WITH_IMAGE = {"gdi_ok", "gdi_failed", "d3d_ok", "d3d_occluded",
+              "d3d_failed", "d3d_other_status"}
+U64_MAX = (1 << 64) - 1
+
+
+def _read_locked(path):
+    """Open a disk file while denying other writers and delete/rename."""
+    if os.name != "nt":
+        raise ValueError("the capture verifier currently requires Windows")
+    import msvcrt
+    from ctypes import wintypes
+
+    kernel = ctypes.WinDLL("kernel32", use_last_error=True)
+    create = kernel.CreateFileW
+    create.argtypes = (wintypes.LPCWSTR, wintypes.DWORD, wintypes.DWORD,
+                       ctypes.c_void_p, wintypes.DWORD, wintypes.DWORD, wintypes.HANDLE)
+    create.restype = wintypes.HANDLE
+    handle = create(os.fspath(path), 0x80000000, 1, None, 3, 0x80, None)
+    if handle == ctypes.c_void_p(-1).value:
+        raise OSError(ctypes.get_last_error(), "cannot exclusively read", str(path))
+    try:
+        fd = msvcrt.open_osfhandle(handle, os.O_RDONLY | os.O_BINARY)
+    except Exception:
+        kernel.CloseHandle(wintypes.HANDLE(handle))
+        raise
+    return os.fdopen(fd, "rb")
+
+
+def _file_identity(file):
+    import msvcrt
+    from ctypes import wintypes
+
+    class FileTime(ctypes.Structure):
+        _fields_ = [("low", wintypes.DWORD), ("high", wintypes.DWORD)]
+
+    class Info(ctypes.Structure):
+        _fields_ = [
+            ("attributes", wintypes.DWORD), ("created", FileTime),
+            ("accessed", FileTime), ("written", FileTime),
+            ("volume", wintypes.DWORD), ("size_high", wintypes.DWORD),
+            ("size_low", wintypes.DWORD), ("links", wintypes.DWORD),
+            ("index_high", wintypes.DWORD), ("index_low", wintypes.DWORD),
+        ]
+
+    get_info = ctypes.WinDLL("kernel32", use_last_error=True).GetFileInformationByHandle
+    get_info.argtypes = (wintypes.HANDLE, ctypes.POINTER(Info))
+    get_info.restype = wintypes.BOOL
+    info = Info()
+    if not get_info(msvcrt.get_osfhandle(file.fileno()), ctypes.byref(info)):
+        raise OSError(ctypes.get_last_error(), "cannot identify statistics file")
+    index = (info.index_high << 32) | info.index_low
+    if not index or info.attributes & 0x10:
+        raise ValueError("statistics file has no usable file identity")
+    return info.volume, index
+
+
+def _read(path):
+    with _read_locked(path) as file:
+        return file.read()
+
+
+def _uint(value, name, maximum=U64_MAX):
+    if not isinstance(value, str) or not re.fullmatch(r"0|[1-9][0-9]*", value):
+        raise ValueError(f"invalid {name}")
+    number = int(value)
+    if number > maximum:
+        raise ValueError(f"{name} is out of range")
+    return number
+
+
+def _csv(data, header):
+    try:
+        text = data.decode("ascii")
+        rows = list(csv.reader(io.StringIO(text, newline=""), strict=True))
+    except (UnicodeDecodeError, csv.Error) as exc:
+        raise ValueError("invalid CSV") from exc
+    if not text.endswith("\n") or not rows or rows[0] != header:
+        raise ValueError("missing or invalid CSV header or final newline")
+    if any(len(row) != len(header) for row in rows[1:]):
+        raise ValueError("malformed CSV row")
+    return [dict(zip(header, row)) for row in rows[1:]]
+
+
+def _stats(path):
+    with _read_locked(path) as file:
+        identity = _file_identity(file)
+        rows = _csv(file.read(), STATS_FIELDS)
+    entries = {}
+    last_time = 0
+    for expected, row in enumerate(rows, 1):
+        flip = _uint(row["flip"], "statistics flip", (1 << 32) - 1)
+        when = _uint(row["t_us"], "statistics time")
+        _uint(row["draws"], "statistics draws", (1 << 32) - 1)
+        _uint(row["program_vertices"], "statistics vertices", (1 << 32) - 1)
+        if (flip != expected or when < last_time or
+                not re.fullmatch(r"[0-9a-f]{16}", row["hash"]) or
+                not re.fullmatch(r"[0-9a-f]{16}", row["constants"]) or
+                row["distinct"] not in {"-1", "0", "1"} or
+                ((row["hash"] == "0000000000000000") != (row["distinct"] == "-1"))):
+            raise ValueError("statistics rows are incomplete, duplicated, or inconsistent")
+        entries[flip] = row
+        last_time = when
+    return identity, entries
+
+
+def _image(path, width, height, expected_hash):
+    if path.is_symlink() or not path.is_file():
+        raise ValueError(f"missing or unsafe image: {path.name}")
+    with _read_locked(path) as file:
+        header = file.read(54)
+        if len(header) != 54 or header[:2] != b"BM":
+            raise ValueError(f"invalid BMP: {path.name}")
+        size = width * height * 4
+        if (struct.unpack_from("<I", header, 2)[0] != size + 54 or
+                struct.unpack_from("<I", header, 10)[0] != 54 or
+                struct.unpack_from("<I", header, 14)[0] != 40 or
+                struct.unpack_from("<ii", header, 18) != (width, -height) or
+                struct.unpack_from("<HH", header, 26) != (1, 32) or
+                struct.unpack_from("<I", header, 30)[0] != 0 or
+                struct.unpack_from("<I", header, 34)[0] != size):
+            raise ValueError(f"invalid BMP dimensions or format: {path.name}")
+        digest, left = 14695981039346656037, size
+        while left:
+            block = file.read(min(left, 1024 * 1024))
+            if not block:
+                raise ValueError(f"truncated BMP: {path.name}")
+            for byte in block:
+                digest = ((digest ^ byte) * 1099511628211) & U64_MAX
+            left -= len(block)
+        if file.read(1) or f"{digest:016x}" != expected_hash:
+            raise ValueError(f"BMP length or checksum mismatch: {path.name}")
+
+
+def validate(directory, stats_path=None):
+    directory = Path(directory)
+    marker = _read(directory / "complete.txt").decode("ascii").split("\n")
+    if (len(marker) != 4 or marker[3] or marker[0] != "version=1" or
+            not marker[1].startswith("last_sequence=") or
+            marker[2] not in {"reason=window_closed", "reason=thread_stopped"}):
+        raise ValueError("capture has no valid completion marker")
+    final_sequence = _uint(marker[1].split("=", 1)[1], "final sequence")
+    records = _csv(_read(directory / "submissions.csv"), FIELDS)
+    if len(records) != final_sequence:
+        raise ValueError("capture sequence does not match completion marker")
+    identity, stats = _stats(stats_path) if stats_path is not None else (None, {})
+    results, expected_images = [], set()
+    last_end = last_publication = last_candidate = 0
+    for sequence, row in enumerate(records, 1):
+        numbers = {name: _uint(row[name], name) for name in (
+            "sequence", "start_ns", "end_ns", "publication_id", "flip_candidate",
+            "stats_volume", "stats_file_index", "pitch", "aa_sy", "overlay",
+            "pinned", "width", "height",
+        )}
+        if (numbers["sequence"] != sequence or numbers["start_ns"] < last_end or
+                numbers["end_ns"] < numbers["start_ns"] or
+                (numbers["publication_id"] and numbers["publication_id"] < last_publication) or
+                (numbers["flip_candidate"] and numbers["flip_candidate"] < last_candidate) or
+                numbers["flip_candidate"] > (1 << 32) - 1 or
+                numbers["stats_volume"] > (1 << 32) - 1 or
+                any(numbers[name] > (1 << 32) - 1 for name in ("pitch", "aa_sy", "width", "height")) or
+                numbers["overlay"] > 1 or numbers["pinned"] > 1 or
+                row["origin"] not in {"missing", "fallback", "pinned", "flip"} or
+                row["stats"] not in {"untracked", "disabled", "ready", "no_identity", "exhausted"} or
+                row["pixels"] not in {"unknown", "cpu", "readback", "readback_failed",
+                                      "readback_unavailable"} or
+                row["route"] not in ROUTES or row["status"] not in ROUTES[row["route"]] or
+                not re.fullmatch(r"0x[0-9A-F]{8}", row["detail"]) or
+                not re.fullmatch(r"[0-9a-f]{16}", row["image_fnv64"])):
+            raise ValueError(f"invalid metadata at sequence {sequence}")
+        is_flip = row["origin"] == "flip"
+        candidate = numbers["flip_candidate"]
+        if (is_flip != bool(numbers["publication_id"]) or
+                ((row["origin"] == "missing") != (row["route"] == "none")) or
+                (row["origin"] == "pinned" and not numbers["pinned"]) or
+                (numbers["pinned"] and numbers["overlay"]) or
+                (candidate and (not is_flip or numbers["pinned"] or row["stats"] != "ready" or
+                                not numbers["stats_file_index"] or
+                                row["pixels"] not in {"cpu", "readback"})) or
+                (row["stats"] == "ready" and not numbers["stats_file_index"]) or
+                (row["stats"] != "ready" and
+                 (numbers["stats_volume"] or numbers["stats_file_index"]))):
+            raise ValueError(f"inconsistent provenance at sequence {sequence}")
+        detail = int(row["detail"], 16)
+        if ((row["status"] == "no_input" and detail != 0) or
+                (row["status"] == "gdi_ok" and detail in {0, 0xffffffff}) or
+                (row["status"] == "gdi_failed" and detail not in {0, 0xffffffff}) or
+                (row["status"] in {"d3d_no_surface", "d3d_target_failed"} and detail != 0) or
+                (row["status"] == "d3d_resize_failed" and not detail & 0x80000000) or
+                (row["status"] == "d3d_ok" and detail != 0) or
+                (row["status"] == "d3d_occluded" and detail != 0x087a0001) or
+                (row["status"] == "d3d_failed" and not detail & 0x80000000) or
+                (row["status"] == "d3d_other_status" and
+                 (detail in {0, 0x087a0001} or detail & 0x80000000))):
+            raise ValueError(f"inconsistent API result at sequence {sequence}")
+        width, height = numbers["width"], numbers["height"]
+        has_image = row["status"] in WITH_IMAGE
+        if has_image:
+            expected_name = f"present-{sequence:020d}.bmp"
+            if (not width or not height or width > 0x7fffffff or height > 0x7fffffff or
+                    width * height * 4 > 0xffffffff - 54 or row["image"] != expected_name):
+                raise ValueError(f"invalid image reference at sequence {sequence}")
+            _image(directory / expected_name, width, height, row["image_fnv64"])
+            expected_images.add(expected_name)
+        elif row["image"] or row["image_fnv64"] != "0000000000000000":
+            raise ValueError(f"unexpected image at sequence {sequence}")
+        bpp = numbers["pitch"] // width if width else 0
+        expected_format = {2: "rgb565", 4: "xrgb8888", 8: "aa2x32"}.get(
+            bpp, "unsupported_black" if bpp else "unknown")
+        if row["format"] != expected_format:
+            raise ValueError(f"inconsistent format at sequence {sequence}")
+        reasons = []
+        if not is_flip:
+            reasons.append("no_flip_snapshot" if row["origin"] != "missing" else "no_input")
+        if numbers["pinned"]:
+            reasons.append("pinned")
+        if row["stats"] != "ready":
+            reasons.append("statistics_" + row["stats"])
+        if row["pixels"] not in {"cpu", "readback"}:
+            reasons.append("pixels_" + row["pixels"])
+        if row["format"] not in {"rgb565", "xrgb8888", "aa2x32"}:
+            reasons.append("unsupported_format")
+        if row["status"] not in {"gdi_ok", "d3d_ok"}:
+            reasons.append(row["status"])
+        if not has_image:
+            reasons.append("no_image")
+        if not candidate:
+            reasons.append("no_flip_candidate")
+        elif identity is None:
+            reasons.append("statistics_not_provided")
+        elif identity != (numbers["stats_volume"], numbers["stats_file_index"]):
+            reasons.append("statistics_identity_mismatch")
+        elif candidate not in stats:
+            reasons.append("statistics_row_missing")
+        elif stats[candidate]["hash"] == "0000000000000000":
+            reasons.append("statistics_hash_unknown")
+        results.append({"sequence": sequence, "publication_id": numbers["publication_id"],
+                        "flip_candidate": candidate, "flip_link_verified": not reasons,
+                        "reasons": reasons, "route": row["route"], "status": row["status"],
+                        "overlay": bool(numbers["overlay"]), "image": row["image"] or None})
+        last_end = numbers["end_ns"]
+        if numbers["publication_id"]:
+            last_publication = numbers["publication_id"]
+        if candidate:
+            last_candidate = candidate
+    actual_images = {p.name for p in directory.glob("present-*.bmp")}
+    if actual_images != expected_images or list(directory.glob("*.partial")):
+        raise ValueError("capture has orphaned or partial image files")
+    return {
+        "scope": "presenter submission to guest flip only; not scanout, visibility, or world FPS",
+        "records": results,
+    }
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("directory", help="completed presenter capture directory")
+    parser.add_argument("--stats", help="the same run's exclusive RECOMP_FRAME_STATS file")
+    args = parser.parse_args(argv)
+    try:
+        result = validate(args.directory, args.stats)
+    except (OSError, ValueError, UnicodeError) as exc:
+        print(f"presenter capture verification failed: {exc}", file=sys.stderr)
+        return 2
+    print(json.dumps(result, indent=2))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
