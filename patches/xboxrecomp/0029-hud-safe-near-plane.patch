+        else if (s_gpu.program_near_mode == NV_PROGRAM_NEAR_HUD)
+            s_xf_o[2] = additive_blend()
+                ? (of[2] > 1e-6f ? of[2] : 1e-6f)
+                : 0.0f;
+    }
 }
 
