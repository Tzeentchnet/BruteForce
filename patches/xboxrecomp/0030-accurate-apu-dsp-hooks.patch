diff --git a/src/kernel/kernel_memory.c b/src/kernel/kernel_memory.c
index 43897a1..3754df3 100644
--- a/src/kernel/kernel_memory.c
+++ b/src/kernel/kernel_memory.c
@@ -16,6 +16,23 @@
 #include <malloc.h>
 #endif
 
+/* A physical number below 64 MB can identify both ordinary RAM and the
+ * separate contiguous window in this runtime. Record which storage the most
+ * recent MmGetPhysicalAddress call named so device models can preserve the
+ * caller's intent when they cache scatter-gather entries. */
+static volatile uint8_t g_phys_last_translation[(64u << 20) / 4096];
+
+const volatile uint8_t *xbox_PhysLastTranslationMap(void)
+{
+    return g_phys_last_translation;
+}
+
+static void note_physical_translation(uint32_t physical, uint8_t storage)
+{
+    if (physical < (64u << 20))
+        g_phys_last_translation[physical >> 12] = storage;
+}
+
 /* ============================================================================
  * Helper: Xbox protect flags → Win32 protect flags
  * ============================================================================ */
@@ -170,11 +187,15 @@ ULONG_PTR __stdcall xbox_MmGetPhysicalAddress(PVOID BaseAddress)
      */
     uint32_t va = (uint32_t)(uintptr_t)BaseAddress;
     if (va >= XBOX_CONTIG_BASE &&
-            (uint64_t)va < (uint64_t)XBOX_CONTIG_BASE + XBOX_CONTIG_SIZE)
-        return (ULONG_PTR)(va - XBOX_CONTIG_BASE);
+            (uint64_t)va < (uint64_t)XBOX_CONTIG_BASE + XBOX_CONTIG_SIZE) {
+        uint32_t physical = va - XBOX_CONTIG_BASE;
+        note_physical_translation(physical, 2);
+        return (ULONG_PTR)physical;
+    }
     /* The same number can be a window page; record that the title meant RAM
      * (xbox_PhysNoteRamName says why the APU needs to know). */
     xbox_PhysNoteRamName(va);
+    note_physical_translation(va, 1);
     return (ULONG_PTR)va;
 }
 
