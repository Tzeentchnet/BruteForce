+int xbox_Nv2aPfbFlushWait(void)
+{
+    volatile uint32_t *reg;
+
+    if (!nv2a_pfb_flush_wait_enabled())
+        return 0;
+    reg = xbox_Nv2aRegPtr(NV2A_ACK_PFB_FLUSH);
+    if (!reg) {
+        fprintf(stderr, "[PFB-WAIT] NV2A aperture is not mapped\n");
+        abort();
+    }
+    nv2a_pfb_flush_wait(reg, xbox_IrqSafePoint);
+    return 1;
+}
+
+int xbox_Nv2aPfbFlushWaitEnabled(void)
+{
+    return nv2a_pfb_flush_wait_enabled();
+}
+
 /* One word of the NV2A register file (offset from the register base), or NULL
  * before it is mapped. The pushbuffer executor writes what the GPU would when
  * it executes a command: PGRAPH state a title reads back, and DMA_GET. */
