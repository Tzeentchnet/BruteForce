diff --git a/tests/nv2a_pfb_flush/test_main.c b/tests/nv2a_pfb_flush/test_main.c
new file mode 100644
index 0000000..a0a604f
--- /dev/null
+++ b/tests/nv2a_pfb_flush/test_main.c
@@ -0,0 +1,168 @@
+#include "nv2a_pfb_flush.h"
+#include "platform/xbox_winnt.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static volatile uint32_t s_reg;
+static volatile LONG s_started;
+static volatile LONG s_completed;
+static volatile LONG s_safe_points;
+static volatile LONG s_clear_after;
+static int s_failures;
+
+static void check(int condition, const char *what)
+{
+    printf("  %-58s %s\n", what, condition ? "PASS" : "FAIL");
+    if (!condition)
+        s_failures++;
+}
+
+static void set_option(const char *value)
+{
+#if defined(_WIN32)
+    if (_putenv_s("RECOMP_PFB_FLUSH_WAIT", value) != 0)
+        abort();
+#else
+    if (setenv("RECOMP_PFB_FLUSH_WAIT", value, 1) != 0)
+        abort();
+#endif
+}
+
+static void safe_point(void)
+{
+    LONG count = InterlockedIncrement(&s_safe_points);
+
+    if (s_clear_after && count >= s_clear_after)
+        InterlockedAnd((volatile LONG *)&s_reg,
+                       (LONG)~NV2A_PFB_FLUSH_BUSY_MASK);
+}
+
+static DWORD WINAPI wait_thread(LPVOID unused)
+{
+    (void)unused;
+    InterlockedExchange(&s_started, 1);
+    nv2a_pfb_flush_wait(&s_reg, safe_point);
+    InterlockedExchange(&s_completed, 1);
+    return 0;
+}
+
+static HANDLE start_wait(LONG clear_after)
+{
+    HANDLE thread;
+
+    s_reg = NV2A_PFB_FLUSH_BUSY_MASK;
+    InterlockedExchange(&s_started, 0);
+    InterlockedExchange(&s_completed, 0);
+    InterlockedExchange(&s_safe_points, 0);
+    InterlockedExchange(&s_clear_after, clear_after);
+    thread = CreateThread(NULL, 0, wait_thread, NULL, 0, NULL);
+    if (!thread)
+        abort();
+    while (!InterlockedCompareExchange(&s_started, 0, 0))
+        SwitchToThread();
+    return thread;
+}
+
+static void join_wait(HANDLE thread)
+{
+    check(WaitForSingleObject(thread, 5000) == WAIT_OBJECT_0,
+          "waiter completes within five seconds");
+    CloseHandle(thread);
+}
+
+static void test_normal(void)
+{
+    HANDLE thread = start_wait(0);
+
+    Sleep(5);
+    check(!s_completed, "waiter blocks while the flush bit is set");
+    check(!nv2a_pfb_flush_ack(&s_reg, 1),
+          "a flip hold refuses the acknowledgement");
+    check((s_reg & NV2A_PFB_FLUSH_BUSY_MASK) != 0,
+          "a flip hold leaves the flush bit set");
+    Sleep(5);
+    check(!s_completed, "a held acknowledgement does not wake the waiter");
+    check(nv2a_pfb_flush_ack(&s_reg, 0),
+          "the real acknowledgement clears the bit");
+    join_wait(thread);
+    check(!(s_reg & NV2A_PFB_FLUSH_BUSY_MASK),
+          "the completed wait observes the cleared bit");
+}
+
+static void test_spurious(void)
+{
+    volatile uint32_t other = NV2A_PFB_FLUSH_BUSY_MASK;
+    HANDLE thread = start_wait(0);
+
+    Sleep(2);
+    check(nv2a_pfb_flush_ack(&other, 0),
+          "an unrelated acknowledgement signals the shared event");
+    Sleep(5);
+    check(!s_completed && (s_reg & NV2A_PFB_FLUSH_BUSY_MASK),
+          "an event wake cannot complete while the target bit remains set");
+    nv2a_pfb_flush_ack(&s_reg, 0);
+    join_wait(thread);
+}
+
+static void test_timeout(void)
+{
+    HANDLE thread = start_wait(3);
+
+    join_wait(thread);
+    check(s_safe_points >= 3,
+          "the 200 us backstop repeatedly runs the safe point");
+    check(!s_completed || !(s_reg & NV2A_PFB_FLUSH_BUSY_MASK),
+          "a lost acknowledgement signal cannot strand a cleared bit");
+}
+
+static void test_reuse(void)
+{
+    int i;
+
+    for (i = 0; i < 32; ++i) {
+        HANDLE thread = start_wait(0);
+
+        if (i & 1) {
+            Sleep(2);
+            check(!s_completed,
+                  "a retained event cannot complete a reused busy register");
+        }
+        nv2a_pfb_flush_ack(&s_reg, 0);
+        join_wait(thread);
+    }
+}
+
+int main(int argc, char **argv)
+{
+    const char *mode = argc > 1 ? argv[1] : "";
+
+    setvbuf(stdout, NULL, _IONBF, 0);
+    if (strcmp(mode, "invalid") == 0) {
+        set_option("maybe");
+        (void)nv2a_pfb_flush_wait_enabled();
+        return 0;
+    }
+    if (strcmp(mode, "disabled") == 0) {
+        set_option("0");
+        check(!nv2a_pfb_flush_wait_enabled(),
+              "the event-driven wait is off by default");
+    } else {
+        set_option("1");
+        check(nv2a_pfb_flush_wait_enabled(), "the option enables the wait");
+        if (strcmp(mode, "normal") == 0)
+            test_normal();
+        else if (strcmp(mode, "spurious") == 0)
+            test_spurious();
+        else if (strcmp(mode, "timeout") == 0)
+            test_timeout();
+        else if (strcmp(mode, "reuse") == 0)
+            test_reuse();
+        else {
+            fprintf(stderr, "unknown mode: %s\n", mode);
+            return 2;
+        }
+    }
+    return s_failures ? 1 : 0;
+}
