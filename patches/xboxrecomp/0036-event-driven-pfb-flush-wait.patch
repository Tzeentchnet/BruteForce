 volatile uint32_t *xbox_Nv2aRegPtr(uint32_t offset);
+/* Wait for the real PFB flush acknowledgement when
+ * RECOMP_PFB_FLUSH_WAIT=1. Returns 0 when the option is disabled so a
+ * title-specific hook can retain its original polling loop. */
+int xbox_Nv2aPfbFlushWait(void);
+int xbox_Nv2aPfbFlushWaitEnabled(void);
 /* Registered counters the title turned out to move itself (its vblank DPC),
