--- a/tests/presenter_capture/test_present_capture.py
+++ b/tests/presenter_capture/test_present_capture.py
@@ -310,6 +310,57 @@ class PresenterCaptureTests(unittest.TestCase):
             with self.subTest(mode=mode):
                 self.run_exe("shared_gpu_capture_test", mode)
 
+    def test_presenter_shared_loss_and_nonfatal_open_fallback(self):
+        devices = ["warp"]
+        if os.environ.get("PRESCAP_TEST_SKIP_HARDWARE") != "1":
+            devices.append("hardware")
+        for device in devices:
+            for stage in ("shared-open", "shared-acquire", "shared-release"):
+                with self.subTest(device=device, stage=stage, failure="loss"):
+                    marker = self.work / ("loss-" + uuid.uuid4().hex)
+                    result = self.run_exe("device_loss_test", stage, "loss", device, marker,
+                                          succeeds=False)
+                    self.assertIn("presenter device lost", result.stderr)
+                    self.assertIn("recovery is not implemented", result.stderr)
+                    self.assertEqual(marker.read_bytes(), b"pending")
+            for stage in ("shared-acquire", "shared-release"):
+                with self.subTest(device=device, stage=stage, failure="resource"):
+                    marker = self.work / ("failure-" + uuid.uuid4().hex)
+                    result = self.run_exe("device_loss_test", stage, "error", device, marker,
+                                          succeeds=False)
+                    self.assertIn("resource recovery is not implemented", result.stderr)
+                    self.assertEqual(marker.read_bytes(), b"pending")
+            marker = self.work / ("fallback-" + uuid.uuid4().hex)
+            result = self.run_exe("device_loss_test", "shared-open", "error", device, marker)
+            self.assertIn("falls back to CPU", result.stdout)
