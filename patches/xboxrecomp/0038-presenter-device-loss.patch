diff --git a/tests/presenter_capture/device_loss_test.c b/tests/presenter_capture/device_loss_test.c
new file mode 100644
index 0000000..0ecb83e
--- /dev/null
+++ b/tests/presenter_capture/device_loss_test.c
@@ -0,0 +1,127 @@
+#define COBJMACROS
+#define RECOMP_PRESENT_TESTING
+#include <windows.h>
+#include <d3d11.h>
+#include <dxgi.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "video/gpu_present.c"
+
+#define REQUIRE(c) do { if (!(c)) { fprintf(stderr, "FAIL %d: %s\n", __LINE__, #c); return 1; } } while (0)
+
+static void inject(const char *stage, int loss)
+{
+    s_present_test_stage = stage;
+    s_present_test_result = loss ? DXGI_ERROR_DEVICE_REMOVED : E_OUTOFMEMORY;
+}
+
+static int shared_test(const char *stage, int loss, int hardware)
+{
+    D3D_FEATURE_LEVEL feature = D3D_FEATURE_LEVEL_11_0, obtained;
+    D3D_DRIVER_TYPE driver = hardware ? D3D_DRIVER_TYPE_HARDWARE : D3D_DRIVER_TYPE_WARP;
+    ID3D11Device *producer = NULL;
+    ID3D11DeviceContext *context = NULL;
+    ID3D11Texture2D *texture = NULL;
+    IDXGIResource *resource = NULL;
+    IDXGIKeyedMutex *mutex = NULL;
+    D3D11_TEXTURE2D_DESC td;
+    HANDLE handle = NULL;
+    uint32_t width = 0, height = 0;
+    int held = 0;
+    ID3D11ShaderResourceView *view;
+
+    REQUIRE(SUCCEEDED(D3D11CreateDevice(NULL, driver, NULL, 0, &feature, 1,
+                                        D3D11_SDK_VERSION, &producer, &obtained, &context)));
+    REQUIRE(SUCCEEDED(D3D11CreateDevice(NULL, driver, NULL, 0, &feature, 1,
+                                        D3D11_SDK_VERSION, &s_dev, &obtained, &s_ctx)));
+    memset(&td, 0, sizeof td);
+    td.Width = td.Height = 8;
+    td.MipLevels = td.ArraySize = 1;
+    td.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    td.SampleDesc.Count = 1;
+    td.Usage = D3D11_USAGE_DEFAULT;
+    td.BindFlags = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET;
+    td.MiscFlags = D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX;
+    REQUIRE(SUCCEEDED(ID3D11Device_CreateTexture2D(producer, &td, NULL, &texture)));
+    REQUIRE(SUCCEEDED(ID3D11Texture2D_QueryInterface(texture, &IID_IDXGIResource,
+                                                      (void **)&resource)));
+    REQUIRE(SUCCEEDED(IDXGIResource_GetSharedHandle(resource, &handle)) && handle);
+    REQUIRE(SUCCEEDED(ID3D11Texture2D_QueryInterface(texture, &IID_IDXGIKeyedMutex,
+                                                      (void **)&mutex)));
+    REQUIRE(IDXGIKeyedMutex_AcquireSync(mutex, 0, 0) == S_OK);
+    ID3D11DeviceContext_Flush(context);
+    REQUIRE(IDXGIKeyedMutex_ReleaseSync(mutex, 1) == S_OK);
+    REQUIRE(IDXGIKeyedMutex_AcquireSync(mutex, 1, 5000) == S_OK);
+    REQUIRE(IDXGIKeyedMutex_ReleaseSync(mutex, 1) == S_OK);
+    s_w = s_h = 8;
+    InterlockedExchange(&s_shared_ready, 1);
+    REQUIRE(gpu_present_submit_shared(handle, 8, 8, 1));
+    inject(stage, loss);
+    view = take_shared(strcmp(stage, "shared-release") != 0, 1, &held, &width, &height);
+    REQUIRE(!view && !held && strcmp(stage, "shared-open") == 0 && !loss &&
+            !gpu_present_shared_ready(8, 8));
+    IDXGIKeyedMutex_Release(mutex);
+    IDXGIResource_Release(resource);
+    ID3D11Texture2D_Release(texture);
+    ID3D11DeviceContext_Release(context);
+    ID3D11Device_Release(producer);
+    gpu_present_shutdown();
+    puts("shared open falls back to CPU");
+    return 0;
+}
+
+static int window_test(const char *stage, int loss)
+{
+    HWND window;
+    uint32_t pixels[64] = {0};
+    int init_stage = strncmp(stage, "init-", 5) == 0;
+
+    window = CreateWindowA("STATIC", "synthetic presenter loss", WS_OVERLAPPEDWINDOW,
+                           0, 0, 200, 200, NULL, NULL, GetModuleHandleA(NULL), NULL);
+    REQUIRE(window);
+    _putenv_s("RECOMP_FB_VA", "");
+    _putenv_s("RECOMP_PRESENT_VSYNC", "0");
+    if (init_stage)
+        inject(stage, loss);
+    if (!gpu_present_init(window, 8, 8)) {
+        REQUIRE(init_stage && !loss);
+        DestroyWindow(window);
+        puts("initial resource failure falls back to GDI");
+        return 0;
+    }
+    if (strcmp(stage, "reason") == 0)
+        s_present_test_reason = DXGI_ERROR_DEVICE_REMOVED;
+    else
+        inject(stage, loss);
+    if (strcmp(stage, "resize") == 0 || strcmp(stage, "back-buffer") == 0 ||
+        strcmp(stage, "render-target") == 0)
+        REQUIRE(SetWindowPos(window, NULL, 0, 0, 300, 240,
+                             SWP_NOMOVE | SWP_NOZORDER | SWP_NOACTIVATE));
+    gpu_present_frame(pixels, 0, 1);
+    gpu_present_shutdown();
+    DestroyWindow(window);
+    return 1;
+}
+
+int main(int argc, char **argv)
+{
+    FILE *marker;
+    int result, loss;
+
+    SetErrorMode(SEM_NOGPFAULTERRORBOX | SEM_FAILCRITICALERRORS);
+    if (argc != 5)
+        return 2;
+    loss = strcmp(argv[2], "loss") == 0;
+    marker = fopen(argv[4], "wb");
+    REQUIRE(marker && fwrite("pending", 1, 7, marker) == 7 && fflush(marker) == 0);
+    if (strncmp(argv[1], "shared-", 7) == 0)
+        result = shared_test(argv[1], loss, strcmp(argv[3], "hardware") == 0);
+    else
+        result = window_test(argv[1], loss);
+    if (result)
+        return result;
+    REQUIRE(fwrite(" completed", 1, 10, marker) == 10 && fclose(marker) == 0);
+    return 0;
+}
