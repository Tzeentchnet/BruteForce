diff --git a/tests/display_awake/test_main.c b/tests/display_awake/test_main.c
new file mode 100644
index 0000000..ef6f7e1
--- /dev/null
+++ b/tests/display_awake/test_main.c
@@ -0,0 +1,131 @@
+#include "display_awake.h"
+
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#define HOST ((HWND)(uintptr_t)1)
+#define CHILD ((HWND)(uintptr_t)2)
+#define OTHER ((HWND)(uintptr_t)3)
+#define CHECK(c) do { if (!(c)) { \
+    fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #c); return 1; \
+} } while (0)
+
+static HWND s_foreground;
+static int s_iconic, s_visible = 1, s_valid = 1, s_fail_root;
+static int s_fail_set, s_held;
+static unsigned s_calls;
+static EXECUTION_STATE s_last;
+
+static BOOL WINAPI fake_is_window(HWND h)
+{
+    return h == OTHER || (s_valid && (h == HOST || h == CHILD));
+}
+
+static HWND WINAPI fake_root(HWND h, UINT kind)
+{
+    if (kind != GA_ROOT || s_fail_root)
+        return NULL;
+    return h == CHILD ? HOST : h;
+}
+
+static HWND WINAPI fake_foreground(void) { return s_foreground; }
+static BOOL WINAPI fake_iconic(HWND h) { return h == HOST && s_iconic; }
+static BOOL WINAPI fake_visible(HWND h) { return h != HOST || s_visible; }
+static DWORD WINAPI fake_error(void) { return 1234; }
+
+static EXECUTION_STATE WINAPI fake_set(EXECUTION_STATE flags)
+{
+    ++s_calls;
+    s_last = flags;
+    if (s_fail_set)
+        return 0;
+    s_held = (flags & ES_DISPLAY_REQUIRED) != 0;
+    return ES_CONTINUOUS;
+}
+
+static const RecompDisplayAwakeApi s_api = {
+    fake_is_window, fake_root, fake_foreground, fake_iconic, fake_visible,
+    fake_set, fake_error
+};
+
+int main(void)
+{
+    RecompDisplayAwake state;
+
+    CHECK(recomp_display_awake_init(&state, NULL, &s_api));
+    s_foreground = HOST;
+    recomp_display_awake_update(&state, CHILD);
+    CHECK(s_calls == 0 && !s_held);
+    CHECK(!recomp_display_awake_init(&state, "yes", &s_api));
+    recomp_display_awake_update(&state, HOST);
+    CHECK(s_calls == 0 && !s_held);
+
+    CHECK(recomp_display_awake_init(&state, "1", &s_api));
+    s_foreground = CHILD;
+    recomp_display_awake_update(&state, CHILD);
+    CHECK(s_calls == 1 && s_held && state.held &&
+          s_last == (ES_CONTINUOUS | ES_DISPLAY_REQUIRED));
+    recomp_display_awake_update(&state, HOST);
+    CHECK(s_calls == 1);
+    s_foreground = OTHER;
+    recomp_display_awake_update(&state, CHILD);
+    CHECK(s_calls == 2 && !s_held && !state.held && s_last == ES_CONTINUOUS);
+    s_foreground = HOST;
+    recomp_display_awake_update(&state, CHILD);
+    CHECK(s_calls == 3 && s_held);
+    s_iconic = 1;
+    recomp_display_awake_update(&state, CHILD);
+    CHECK(s_calls == 4 && !s_held);
+    s_iconic = 0;
+    recomp_display_awake_update(&state, CHILD);
+    CHECK(s_calls == 5 && s_held);
+    s_visible = 0;
+    recomp_display_awake_update(&state, CHILD);
+    CHECK(s_calls == 6 && !s_held);
+    s_visible = 1;
+
+    s_fail_set = 1;
+    recomp_display_awake_update(&state, CHILD);
+    CHECK(s_calls == 7 && !s_held && !state.held);
+    s_fail_set = 0;
+    recomp_display_awake_update(&state, CHILD);
+    CHECK(s_calls == 8 && s_held && state.held);
+    s_fail_set = 1;
+    s_foreground = OTHER;
+    recomp_display_awake_update(&state, CHILD);
+    CHECK(s_calls == 9 && s_held && state.held);
+    s_fail_set = 0;
+    recomp_display_awake_update(&state, CHILD);
+    CHECK(s_calls == 10 && !s_held && !state.held);
+
+    s_foreground = HOST;
+    recomp_display_awake_update(&state, CHILD);
+    CHECK(s_calls == 11 && s_held);
+    s_fail_root = 1;
+    recomp_display_awake_update(&state, CHILD);
+    CHECK(s_calls == 12 && !s_held && !state.held);
+    s_fail_root = 0;
+    recomp_display_awake_update(&state, CHILD);
+    CHECK(s_calls == 13 && s_held);
+    s_valid = 0;
+    recomp_display_awake_update(&state, CHILD);
+    CHECK(s_calls == 14 && !s_held);
+    s_valid = 1;
+    recomp_display_awake_update(&state, CHILD);
+    CHECK(s_calls == 15 && s_held);
+    recomp_display_awake_shutdown(&state);
+    CHECK(s_calls == 16 && !s_held && !state.held);
+    recomp_display_awake_shutdown(&state);
+    CHECK(s_calls == 16);
+    recomp_display_awake_update(&state, CHILD);
+    CHECK(s_calls == 17 && s_held);
+    s_fail_set = 1;
+    recomp_display_awake_shutdown(&state);
+    CHECK(s_calls == 18 && s_held && state.held);
+    s_fail_set = 0;
+    recomp_display_awake_shutdown(&state);
+    CHECK(s_calls == 19 && !s_held && !state.held);
+    puts("display-awake window transitions passed");
+    return 0;
+}
