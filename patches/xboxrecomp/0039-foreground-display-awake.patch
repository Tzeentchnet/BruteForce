          * to be ended from Task Manager. The guest has no exit path of its
@@ -759,6 +768,7 @@ static DWORD WINAPI fb_thread(LPVOID unused)
     const char *capture_path = getenv("RECOMP_PRESENTER_CAPTURE");
 
     (void)unused;
