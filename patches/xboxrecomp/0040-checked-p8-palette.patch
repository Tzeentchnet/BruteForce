+static int decode_p8_guest(const Nv2aTexture *tex, uint32_t *out)
+{
+    uintptr_t offset = (uintptr_t)xbox_GetMemoryOffset();
+    uint32_t entries = nv2a_p8_palette_entries(tex->palette_entries);
+    size_t count, pal_bytes;
+    uint8_t *snapshot;
+    int ok;
+
+    if (!entries || !tex->palette || !tex->width || !tex->height ||
+        tex->width > 4096 || tex->height > 4096 ||
+        (tex->width & (tex->width - 1)) || (tex->height & (tex->height - 1)))
+        return 0;
+    count = (size_t)tex->width * tex->height;
+    pal_bytes = (size_t)entries * 4;
+    if (!guest_span_ok(tex->offset, (uint32_t)count) ||
+        !guest_span_ok(tex->palette, (uint32_t)pal_bytes) ||
+        offset > UINTPTR_MAX - tex->offset || offset > UINTPTR_MAX - tex->palette ||
+        count > UINTPTR_MAX - (offset + tex->offset) ||
+        pal_bytes > UINTPTR_MAX - (offset + tex->palette))
+        return 0;
+    snapshot = (uint8_t *)malloc(count + pal_bytes);
+    if (!snapshot)
+        return 0;
+#if defined(_WIN32)
+    {
+        SIZE_T read = 0;
+        ok = ReadProcessMemory(GetCurrentProcess(), (const void *)(offset + tex->offset),
+                               snapshot, count, &read) && read == count;
+        read = 0;
+        ok = ok && ReadProcessMemory(GetCurrentProcess(), (const void *)(offset + tex->palette),
+                                     snapshot + count, pal_bytes, &read) && read == pal_bytes;
+    }
+#else
+    memcpy(snapshot, (const void *)(offset + tex->offset), count);
+    memcpy(snapshot + count, (const void *)(offset + tex->palette), pal_bytes);
+    ok = 1;
+#endif
+    if (ok)
+        ok = nv2a_backend_decode_p8_data(tex, snapshot, count, snapshot + count,
+                                         pal_bytes, out, count);
+    free(snapshot);
+    return ok;
+}
