+static void p8_decoder_tests(void)
+{
+    Nv2aTexture tex = {0};
+    uint32_t output[16], palette[256];
+    uint8_t indices[16];
+    unsigned code, i;
+
+    tex.offset = 0x7000;
+    tex.palette = 0x7400;
+    tex.width = tex.height = 4;
+    tex.color = 0x0B;
+    for (i = 0; i < 256; ++i)
+        palette[i] = 0xFF000000u | i;
+    for (code = 0; code < 4; ++code) {
+        unsigned entries = 256u >> code;
+        tex.palette_entries = entries;
+        memset(indices, entries - 1, sizeof indices);
+        memcpy(s_mem + tex.offset, indices, sizeof indices);
+        memcpy(s_mem + tex.palette, palette, entries * 4);
+        CHECK(nv2a_backend_decode_texture(&tex, output));
+        for (i = 0; i < 16; ++i)
+            CHECK(output[i] == palette[entries - 1]);
+        CHECK(nv2a_backend_decode_p8_data(&tex, indices, sizeof indices,
+                                          palette, entries * 4, output, 16));
+        CHECK(!nv2a_backend_decode_p8_data(&tex, indices, sizeof indices - 1,
+                                           palette, entries * 4, output, 16));
+        CHECK(!nv2a_backend_decode_p8_data(&tex, indices, sizeof indices,
+                                           palette, entries * 4 - 1, output, 16));
+        CHECK(!nv2a_backend_decode_p8_data(&tex, indices, sizeof indices,
+                                           palette, entries * 4, output, 15));
+        if (entries < 256) {
+            indices[15] = (uint8_t)entries;
+            memcpy(s_mem + tex.offset, indices, sizeof indices);
+            for (i = 0; i < 16; ++i)
+                output[i] = 0x12345678u;
+            CHECK(!nv2a_backend_decode_texture(&tex, output));
+            CHECK(!nv2a_backend_decode_p8_data(&tex, indices, sizeof indices,
+                                               palette, entries * 4, output, 16));
+            for (i = 0; i < 16; ++i)
+                CHECK(output[i] == 0x12345678u);
+        }
+    }
+    tex.palette_entries = 0;
+    memset(indices, 255, sizeof indices);
+    CHECK(nv2a_backend_decode_p8_data(&tex, indices, sizeof indices,
+                                      palette, sizeof palette, output, 16));
+    CHECK(output[0] == palette[255]);
+    tex.palette_entries = 33;
+    CHECK(!nv2a_backend_decode_p8_data(&tex, indices, sizeof indices,
+                                       palette, sizeof palette, output, 16));
+    tex.palette_entries = 32;
+    tex.width = 3;
+    CHECK(!nv2a_backend_decode_p8_data(&tex, indices, sizeof indices,
+                                       palette, sizeof palette, output, 16));
+
+#if defined(_WIN32)
+    {
+        DWORD old, ignored;
+        MEMORY_BASIC_INFORMATION info;
+        uint8_t *pages = (uint8_t *)VirtualAlloc(NULL, 8192, MEM_RESERVE | MEM_COMMIT,
+                                                 PAGE_READWRITE);
+        CHECK(pages != NULL);
+        if (pages) {
+            s_mem_base = pages;
+            tex.width = tex.height = 4;
+            tex.offset = 0x100;
+            tex.palette = 4096 - 32 * 4;
+            memset(pages + tex.offset, 31, 16);
+            memcpy(pages + tex.palette, palette, 32 * 4);
+            CHECK(VirtualProtect(pages + 4096, 4096, PAGE_READWRITE | PAGE_GUARD, &old));
+            CHECK(nv2a_backend_decode_texture(&tex, output));
+            CHECK(output[0] == palette[31]);
+            memset(pages + tex.offset, 32, 16);
+            output[0] = 0x12345678u;
+            CHECK(!nv2a_backend_decode_texture(&tex, output));
+            CHECK(output[0] == 0x12345678u);
+            tex.palette = 4096 - 16 * 4;
+            CHECK(!nv2a_backend_decode_texture(&tex, output));
+            CHECK(VirtualQuery(pages + 4096, &info, sizeof info) == sizeof info);
+            CHECK((info.Protect & PAGE_GUARD) != 0);
+            CHECK(VirtualProtect(pages + 4096, 4096, old, &ignored));
+            CHECK(VirtualFree(pages, 0, MEM_RELEASE));
+            s_mem_base = s_mem;
+        }
+    }
+#endif
+}
