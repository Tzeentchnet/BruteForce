+int nv2a_backend_decode_p8_data(const Nv2aTexture *tex,
+                                const void *indices, size_t index_bytes,
+                                const void *palette, size_t palette_bytes,
+                                uint32_t *argb_out, size_t output_texels)
+{
+    const uint8_t *src = (const uint8_t *)indices;
+    const uint8_t *pal = (const uint8_t *)palette;
+    uint32_t entries, x, y;
+    size_t count, i;
+
+    if (!tex || tex->color != 0x0B || !src || !pal || !argb_out ||
+        !tex->width || !tex->height || tex->width > 4096 || tex->height > 4096 ||
+        (tex->width & (tex->width - 1)) || (tex->height & (tex->height - 1)))
+        return 0;
+    entries = nv2a_p8_palette_entries(tex->palette_entries);
+    count = (size_t)tex->width * tex->height;
+    if (!entries || index_bytes < count || palette_bytes < (size_t)entries * 4 ||
+        output_texels < count)
+        return 0;
+    for (i = 0; i < count; ++i)
+        if (src[i] >= entries)
+            return 0;
+    for (y = 0; y < tex->height; ++y)
+        for (x = 0; x < tex->width; ++x) {
+            size_t index = swizzle_offset(x, y, tex->width, tex->height);
+            memcpy(&argb_out[(size_t)y * tex->width + x],
+                   pal + (size_t)src[index] * 4, 4);
+        }
+    return 1;
+}
