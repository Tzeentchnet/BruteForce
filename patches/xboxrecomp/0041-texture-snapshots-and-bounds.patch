+int nv2a_backend_decode_texture_data(const Nv2aTexture *tex,
+                                     const void *data, size_t data_bytes,
+                                     uint32_t *argb_out, size_t output_texels)
+{
+    Texture t;
+    uint32_t fmt, bpp = 0, block, x, y;
+    size_t count;
+    uint64_t required, row;
+    int swizzled;
+
+    if (!tex || !data || !argb_out || !tex->width || !tex->height ||
+        tex->width > 4096 || tex->height > 4096)
+        return 0;
+    count = (size_t)tex->width * tex->height;
+    if (output_texels < count)
+        return 0;
+    fmt = tex->color;
+    block = d3d8_format_dxt_block_bytes(fmt);
+    swizzled = !block && d3d8_format_is_swizzled(fmt);
+    if (swizzled &&
+        swizzle_offset(tex->width - 1, tex->height - 1,
+                       tex->width, tex->height) >= count)
+        return 0;
+    if (block) {
+        required = (uint64_t)((tex->width + 3) / 4) *
+                   ((tex->height + 3) / 4) * block;
+    } else {
+        switch (linear_twin(fmt)) {
+        case 0x12: case 0x1E: case 0x3F: case 0x40: case 0x41: bpp = 4; break;
+        case 0x10: case 0x1C: case 0x11: case 0x1D: bpp = 2; break;
+        case 0x13: case 0x1F: bpp = 1; break;
+        case 0x24: case 0x25:
+            if (swizzled) return 0;
+            if (!tex->pitch) return 0;
+            row = (uint64_t)((tex->width + 1) & ~1u) * 2;
+            required = (uint64_t)(tex->height - 1) * tex->pitch + row;
+            goto sized;
+        default: return 0;
+        }
+        row = (uint64_t)tex->width * bpp;
+        if (swizzled)
+            required = count * bpp;
+        else {
+            if (!tex->pitch) return 0;
+            required = (uint64_t)(tex->height - 1) * tex->pitch + row;
+        }
+    }
+sized:
+    if (data_bytes < required)
+        return 0;
+    memset(&t, 0, sizeof t);
+    t.width = tex->width;
+    t.height = tex->height;
+    t.pitch = tex->pitch;
+    t.color = fmt;
+    t.addr_u = t.addr_v = 3;
+    t.valid = 1;
+    for (y = 0; y < t.height; y++)
+        for (x = 0; x < t.width; x++)
+            if (!sample_tex_mem(&t, (const uint8_t *)data, 0, x, y,
+                                &argb_out[(size_t)y * t.width + x]))
+                return 0;
+    return 1;
