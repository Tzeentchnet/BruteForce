+
+static int reserve_wait_diag_report(void)
+{
+    LONG count = InterlockedCompareExchange(&s_wait_diag_reports, 0, 0);
+    while (count < 8) {
+        LONG previous = InterlockedCompareExchange(&s_wait_diag_reports, count + 1, count);
+        if (previous == count)
+            return 1;
+        count = previous;
+    }
+    return 0;
+}
