+    const char *value = getenv("RECOMP_NV2A_WAIT_DIAG");
+    if (!value || !*value || strcmp(value, "0") == 0)
+        return 0;
+    if (strcmp(value, "1") == 0)
+        return 1;
+    fprintf(stderr, "[NV2A-WAIT] RECOMP_NV2A_WAIT_DIAG must be 0 or 1\n");
+    fflush(stderr);
+    abort();
