diff --git a/tests/nv2a_pfb_flush/check_diag.cmake b/tests/nv2a_pfb_flush/check_diag.cmake
new file mode 100644
index 0000000..16cbc44
--- /dev/null
+++ b/tests/nv2a_pfb_flush/check_diag.cmake
@@ -0,0 +1,20 @@
+foreach(enabled IN ITEMS 0 1)
+    execute_process(
+        COMMAND ${CMAKE_COMMAND} -E env RECOMP_NV2A_WAIT_DIAG=${enabled}
+                "${TEST_EXEC}" normal
+        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error
+        TIMEOUT 5)
+    if(NOT result EQUAL 0)
+        message(FATAL_ERROR "flush diagnostic fixture failed: ${result}\n${output}\n${error}")
+    endif()
+    string(REGEX MATCHALL "\\[NV2A-WAIT\\] PFB flush still busy" lines "${error}")
+    list(LENGTH lines count)
+    if(enabled AND (count LESS 1 OR count GREATER 8))
+        message(FATAL_ERROR "expected 1..8 wait reports, got ${count}\n${error}")
+    elseif(NOT enabled AND count)
+        message(FATAL_ERROR "wait diagnostics are not default-off\n${error}")
+    endif()
+    if(count EQUAL 8 AND NOT error MATCHES "further wait reports suppressed")
+        message(FATAL_ERROR "wait diagnostic suppression was not reported")
+    endif()
+endforeach()
