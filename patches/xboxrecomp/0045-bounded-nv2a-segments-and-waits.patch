diff --git a/tools/recomp/test_store32_hooks.py b/tools/recomp/test_store32_hooks.py
new file mode 100644
index 0000000..13affb6
--- /dev/null
+++ b/tools/recomp/test_store32_hooks.py
@@ -0,0 +1,98 @@
+"""Function-scoped MOV-store hooks leave all other instructions unchanged."""
+
+import os
+import subprocess
+
+import pytest
+
+from tools.recomp import config, translator
+from tools.recomp.c_fixture import command, compiler
+from tools.recomp.manual_scan import store32_hooks
+from tools.recomp.__main__ import _load_manual_protection
+
+
+def test_discovery_and_boundary_protection(tmp_path):
+    manual = tmp_path / "manual.c"
+    manual.write_text("""
+void sub_00010000_store32(uint32_t address, uint32_t value)
+{
+}
+void sub_00010010_store32(uint32_t address, uint32_t value);
+#if 0
+void sub_00010020_store32(uint32_t address, uint32_t value) {}
+#endif
+""", encoding="utf-8")
+    assert store32_hooks(manual) == {0x10000}
+    protected, _ = _load_manual_protection(None, manual)
+    assert 0x10000 in protected
+    assert 0x10010 not in protected and 0x10020 not in protected
+
+
+def test_only_mov_dword_stores_in_the_named_function_are_redirected(monkeypatch):
+    base = 0x10000
+    # MOV [eax+40],ecx; MOV [eax+44],imm; MOV [eax+48],cl;
+    # MOV edx,[eax+4c]; RET.
+    image = bytes.fromhex("89 48 40 c7 40 44 78 56 34 12 88 48 48 8b 50 4c c3")
+    config._install([config.Section(".text", base, len(image), 0, len(image), True)],
+                    entry_point=base, kernel_thunk_addr=base, origin="store-hook-test")
+    db = {base: {"end": base + len(image), "size": len(image)}}
+    monkeypatch.setattr(translator, "STORE32_HOOKS", {base})
+    code = translator.FunctionTranslator(image, db).translate_function(base, db[base])
+    assert code.count("sub_00010000_store32((uint32_t)") == 2
+    assert "MEM8(eax + 0x48)" in code
+    assert "edx = MEM32(eax + 0x4C)" in code
+    monkeypatch.setattr(translator, "STORE32_HOOKS", set())
+    code = translator.FunctionTranslator(image, db).translate_function(base, db[base])
+    assert "store32" not in code
+    assert "MEM32(eax + 0x40) = ecx" in code
+
+
+def test_generated_store_hooks_compile_and_preserve_store_order(tmp_path, monkeypatch):
+    cc = compiler()
+    if not cc:
+        pytest.skip("C compiler unavailable")
+    base = 0x10000
+    image = bytes.fromhex("89 48 40 c7 40 44 78 56 34 12 88 48 48 8b 50 4c c3")
+    config._install([config.Section(".text", base, len(image), 0, len(image), True)],
+                    entry_point=base, kernel_thunk_addr=base, origin="store-hook-c-test")
+    db = {base: {"end": base + len(image), "size": len(image)}}
+    monkeypatch.setattr(translator, "STORE32_HOOKS", {base})
+    generated = translator.FunctionTranslator(image, db).translate_function(base, db[base])
+    source = tmp_path / "store_hook.c"
+    source.write_text(r"""
+#include <stdint.h>
+#include <string.h>
+static uint8_t memory[512];
+static uint32_t eax = 0x100, ecx = 0x9abcdef0, edx, esp, count;
+static uint32_t addresses[2], values[2];
+#define MEM8(a) (memory[(a)])
+#define MEM32(a) (*(uint32_t *)(memory + (a)))
+#define LO8(x) ((uint8_t)(x))
+void sub_00010000_store32(uint32_t address, uint32_t value)
+{
+    if (count < 2) {
+        addresses[count] = address;
+        values[count] = value;
+    }
+    count++;
+    memcpy(memory + address, &value, sizeof(value));
+}
+""" + generated + r"""
+int main(void)
+{
+    uint32_t expected = 0x87654321;
+    memcpy(memory + 0x14c, &expected, sizeof(expected));
+    sub_00010000();
+    return count != 2 || addresses[0] != 0x140 || values[0] != 0x9abcdef0 ||
+           addresses[1] != 0x144 || values[1] != 0x12345678 ||
+           MEM8(0x148) != 0xf0 || edx != expected || esp != 4;
+}
+""", encoding="utf-8")
+    exe = tmp_path / "store_hook.exe"
+    env = dict(os.environ, TEMP=str(tmp_path), TMP=str(tmp_path), TMPDIR=str(tmp_path))
+    result = subprocess.run(command(cc, [source], exe), cwd=tmp_path, env=env,
+                            capture_output=True, text=True, timeout=30)
+    assert result.returncode == 0, result.stderr
+    result = subprocess.run([str(exe)], cwd=tmp_path, env=env,
+                            capture_output=True, text=True, timeout=5)
+    assert result.returncode == 0, result.stderr
