+execute_process(COMMAND "${PROGRAM}" "${MODE}" RESULT_VARIABLE result
+                OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
+if(result STREQUAL "0" OR result MATCHES "timeout")
+    message(FATAL_ERROR "${MODE} did not fail promptly: ${result}\n${output}\n${error}")
+endif()
+if(MODE STREQUAL "timeout")
+    set(expected "queue-space wait timed out")
+elseif(MODE STREQUAL "invalid")
+    set(expected "PUT is outside aligned physical RAM")
+elseif(MODE STREQUAL "reset")
+    set(expected "untracked GET write or reset")
+else()
+    set(expected "untracked guest USER write")
+endif()
+if(NOT error MATCHES "${expected}")
+    message(FATAL_ERROR "${MODE} did not report ${expected}: ${result}\n${error}")
+endif()
diff --git a/tests/nv2a_segments/test_main.c b/tests/nv2a_segments/test_main.c
new file mode 100644
index 0000000..8f22df2
--- /dev/null
+++ b/tests/nv2a_segments/test_main.c
@@ -0,0 +1,211 @@
+#include <windows.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "nv2a_segments.h"
+#include "nv2a_pfb_flush.h"
+#include "nv2a_user_page.h"
+
+#define REQUIRE(c, message) do { if (!(c)) { \
+    fprintf(stderr, "FAIL: %s\n", message); return 1; } } while (0)
+
+static Nv2aUserPage page;
+static volatile uint32_t *put_reg, *get_reg;
+static uint8_t *ram;
+static volatile LONG safe_points;
+static uint32_t dma_subroutine;
+static unsigned seen_count;
+static uint32_t seen[16];
+static int flip_held;
+
+void nv2a_pb_resync(uint32_t);
+void nv2a_pb_scan_staged(uint32_t);
+ptrdiff_t xbox_GetMemoryOffset(void) { return (ptrdiff_t)ram - 0x80000000u; }
+volatile uint32_t *xbox_Nv2aRegPtr(uint32_t offset)
+{
+    if (offset == 0x00324Cu) return &dma_subroutine;
+    if (offset == 0x800044u) return get_reg;
+    return NULL;
+}
+void nv2a_pb_exec_report(void) {}
+void nv2a_pb_exec_walk_begin(void) {}
+void xbox_Nv2aAckBusyBits(void) {}
+int nv2a_pb_exec_constant_word(uint32_t method, uint32_t value)
+{ (void)method; (void)value; return 0; }
+void nv2a_pb_exec_method(uint32_t subchannel, uint32_t method, uint32_t value)
+{
+    (void)subchannel; (void)method;
+    if (!nv2a_segments_pending() || seen_count >= 16)
+        abort();
+    seen[seen_count++] = value;
+    if (value == 4) flip_held = 1;
+}
+static void safe_point(void) { InterlockedIncrement(&safe_points); }
+static void *map_readonly(HANDLE mapping, size_t size, void *address)
+{
+    (void)address;
+    return MapViewOfFile(mapping, FILE_MAP_READ, 0, 0, size);
+}
+static void word(uint32_t offset, uint32_t value)
+{ memcpy(ram + offset, &value, sizeof value); }
+static DWORD WINAPI producer(void *ignored)
+{
+    (void)ignored;
+    nv2a_segments_publish(0x100, 3, safe_point);
+    return 0;
+}
+
+int main(int argc, char **argv)
+{
+    const char *mode = argc == 2 ? argv[1] : "";
+    HANDLE thread;
+    DWORD started;
+    volatile uint32_t flush = NV2A_PFB_FLUSH_BUSY_MASK;
+    SetErrorMode(SEM_NOGPFAULTERRORBOX | SEM_FAILCRITICALERRORS);
+#if defined(_MSC_VER)
+    _set_abort_behavior(0, _WRITE_ABORT_MSG | _CALL_REPORTFAULT);
+#endif
+    _putenv_s("RECOMP_NV2A_SEGMENTS", "1");
+    _putenv_s("RECOMP_PB_EXEC", "1");
+    _putenv_s("RECOMP_PB_WALK", "staged");
+    _putenv_s("RECOMP_PGRAPH_IRQ", "1");
+    REQUIRE(nv2a_user_page_create(&page, NULL, map_readonly), "create guarded alias");
+    put_reg = (volatile uint32_t *)((char *)page.host + 0x40);
+    get_reg = (volatile uint32_t *)((char *)page.host + 0x44);
+    *put_reg = *get_reg = strcmp(mode, "bootstrap") == 0 ? 0 : 0x100;
+    REQUIRE(*(volatile uint32_t *)((char *)page.guest + 0x40) == *put_reg,
+            "guest view sees writable alias");
+    if (strcmp(mode, "guard-store") == 0) {
+        *(volatile uint32_t *)((char *)page.guest + 0x40) = 0x104;
+        return 2;
+    }
+    nv2a_segments_bind(put_reg, get_reg);
+    if (strcmp(mode, "guard") == 0) {
+        nv2a_segments_shutdown();
+        nv2a_user_page_destroy(&page);
+        return 0;
+    }
+    if (strcmp(mode, "invalid") == 0) {
+        nv2a_segments_publish(0x04000000u, 1, safe_point);
+        return 2;
+    }
+    if (strcmp(mode, "reset") == 0) {
+        *get_reg = 0x104;
+        nv2a_segments_publish(0x108, 1, safe_point);
+        return 2;
+    }
+    if (strcmp(mode, "timeout") == 0 || strcmp(mode, "backpressure") == 0) {
+        nv2a_segments_publish(0x100, 1, safe_point);
+        nv2a_segments_publish(0x100, 2, safe_point);
+        if (strcmp(mode, "timeout") == 0) {
+            nv2a_segments_publish(0x100, 3, safe_point);
+            return 2;
+        }
+        thread = CreateThread(NULL, 0, producer, NULL, 0, NULL);
+        REQUIRE(thread != NULL, "start blocked producer");
+        started = GetTickCount();
+        while (!safe_points && (DWORD)(GetTickCount() - started) < 70)
+            Sleep(1);
+        REQUIRE(safe_points, "full queue executes producer IRQ safe points");
+        REQUIRE(nv2a_segments_service(0, nv2a_pb_resync, nv2a_pb_scan_staged),
+                "consume to release queue space");
+        REQUIRE(WaitForSingleObject(thread, 1000) == WAIT_OBJECT_0,
+                "producer wakes after space becomes available");
+        CloseHandle(thread);
+        REQUIRE(nv2a_segments_service(0, nv2a_pb_resync, nv2a_pb_scan_staged) &&
+                nv2a_segments_service(0, nv2a_pb_resync, nv2a_pb_scan_staged) &&
+                !nv2a_segments_pending(), "all publications are consumed in order");
+        nv2a_segments_shutdown();
+        nv2a_user_page_destroy(&page);
+        return 0;
+    }
+    if (strcmp(mode, "bootstrap") == 0) {
+        ram = VirtualAlloc(NULL, 64u * 1024u * 1024u,
+                           MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+        REQUIRE(ram != NULL, "allocate bootstrap RAM");
+        word(0, 0x101u);
+        word(0x100, (1u << 18) | 0x0100u);
+        word(0x104, 7);
+        nv2a_segments_publish(0x108, 1, safe_point);
+        REQUIRE(*get_reg == 0 && nv2a_segments_service(0, nv2a_pb_resync, nv2a_pb_scan_staged) &&
+                *get_reg == 0x108 && seen_count == 1 && seen[0] == 7,
+                "first publication follows the real bootstrap JUMP before advancing GET");
+        nv2a_segments_shutdown();
+        nv2a_user_page_destroy(&page);
+        VirtualFree(ram, 0, MEM_RELEASE);
+        return 0;
+    }
+    if (strcmp(mode, "ordering") == 0) {
+        ram = VirtualAlloc(NULL, 64u * 1024u * 1024u,
+                           MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+        REQUIRE(ram != NULL, "allocate ordering RAM");
+        word(0x100, (4u << 18) | 0x0100u);
+        word(0x104, 1); word(0x108, 2); word(0x10C, 3); word(0x110, 4);
+        word(0x114, (1u << 18) | 0x0300u); word(0x118, 5);
+        nv2a_segments_publish(0x114, 1, safe_point);
+        nv2a_segments_publish(0x11C, 2, safe_point);
+        REQUIRE(!nv2a_pfb_flush_ack(&flush, flip_held || nv2a_segments_pending()) &&
+                flush == NV2A_PFB_FLUSH_BUSY_MASK, "queued work keeps PFB busy");
+        REQUIRE(nv2a_segments_service(0, nv2a_pb_resync, nv2a_pb_scan_staged) &&
+                seen_count == 4 && seen[0] == 1 && seen[1] == 2 &&
+                seen[2] == 3 && seen[3] == 4 && *get_reg == 0x114,
+                "semaphore, report, trap and flip markers precede first GET");
+        REQUIRE(!nv2a_pfb_flush_ack(&flush, flip_held || nv2a_segments_pending()) &&
+                !nv2a_segments_service(flip_held, nv2a_pb_resync, nv2a_pb_scan_staged) &&
+                flush == NV2A_PFB_FLUSH_BUSY_MASK && *get_reg == 0x114,
+                "held flip preserves PFB busy and blocks next segment");
+        flip_held = 0;
+        REQUIRE(!nv2a_pfb_flush_ack(&flush, flip_held || nv2a_segments_pending()) &&
+                nv2a_segments_service(0, nv2a_pb_resync, nv2a_pb_scan_staged) &&
+                seen_count == 5 && seen[4] == 5 && *get_reg == 0x11C,
+                "remaining segment completes before acknowledgement");
+        REQUIRE(nv2a_pfb_flush_ack(&flush, flip_held || nv2a_segments_pending()) &&
+                flush == 0, "real acknowledgement follows GET and queue drain");
+        nv2a_segments_shutdown();
+        nv2a_user_page_destroy(&page);
+        VirtualFree(ram, 0, MEM_RELEASE);
+        return 0;
+    }
+    REQUIRE(strcmp(mode, "flow") == 0, "known test mode");
+    ram = VirtualAlloc(NULL, 64u * 1024u * 1024u,
+                       MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+    REQUIRE(ram != NULL, "allocate synthetic physical RAM");
+    word(0x100, (4u << 18) | 0x0100u);
+    word(0x104, 1); word(0x108, 2); word(0x10C, 3); word(0x110, 4);
+    word(0x114, (1u << 18) | 0x0300u); word(0x118, 5);
+    nv2a_segments_publish(0x10C, 1, safe_point);
+    nv2a_segments_publish(0x114, 2, safe_point);
+    REQUIRE(*get_reg == 0x100, "GET is not published by producer");
+    REQUIRE(nv2a_segments_service(0, nv2a_pb_resync, nv2a_pb_scan_staged),
+            "service first partial packet");
+    REQUIRE(*get_reg == 0x10C && seen_count == 2 && seen[0] == 1 && seen[1] == 2,
+            "first segment carries semaphore then report before GET");
+    nv2a_segments_publish(0x11C, 3, safe_point);
+    REQUIRE(nv2a_segments_service(0, nv2a_pb_resync, nv2a_pb_scan_staged),
+            "service remaining partial packet");
+    REQUIRE(*get_reg == 0x114 && seen_count == 4 && seen[2] == 3 && seen[3] == 4,
+            "trap then flip precede completion");
+    REQUIRE(!nv2a_segments_service(flip_held, nv2a_pb_resync, nv2a_pb_scan_staged) &&
+            *get_reg == 0x114 && seen_count == 4,
+            "held flip blocks the next segment without advancing GET");
+    flip_held = 0;
+    REQUIRE(nv2a_segments_service(flip_held, nv2a_pb_resync, nv2a_pb_scan_staged) &&
+            *get_reg == 0x11C && seen_count == 5 && seen[4] == 5,
+            "next segment follows the released flip");
+    word(0x11C, 0x181u);
+    word(0x180, 0x202u);
+    word(0x184, (1u << 18) | 0x0304u); word(0x188, 7);
+    word(0x200, (1u << 18) | 0x0308u); word(0x204, 6);
+    word(0x208, 0x00020000u);
+    nv2a_segments_publish(0x18C, 4, safe_point);
+    REQUIRE(nv2a_segments_service(0, nv2a_pb_resync, nv2a_pb_scan_staged) &&
+            *get_reg == 0x18C && seen_count == 7 && seen[5] == 6 && seen[6] == 7,
+            "queued segment follows JUMP and CALL/RETURN in order");
+    nv2a_segments_shutdown();
+    nv2a_user_page_destroy(&page);
+    VirtualFree(ram, 0, MEM_RELEASE);
+    return 0;
+}
