diff --git a/tests/nv2a_idle_wait/test_main.c b/tests/nv2a_idle_wait/test_main.c
new file mode 100644
index 0000000..c9e615a
--- /dev/null
+++ b/tests/nv2a_idle_wait/test_main.c
@@ -0,0 +1,156 @@
+#include "nv2a_idle_wait.h"
+#include "nv2a_pfb_flush.h"
+#include "platform/xbox_winnt.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static volatile LONG s_stop, s_passes, s_held, s_completed, s_safe_points;
+static volatile uint32_t s_flush;
+static int s_failures;
+
+static void check(int ok, const char *what)
+{
+    printf("  %-55s %s\n", what, ok ? "PASS" : "FAIL");
+    if (!ok) s_failures++;
+}
+
+static void set_option(const char *name, const char *value)
+{
+#if defined(_WIN32)
+    if (_putenv_s(name, value) != 0) abort();
+#else
+    if (setenv(name, value, 1) != 0) abort();
+#endif
+}
+
+static void safe_point(void)
+{
+    InterlockedIncrement(&s_safe_points);
+}
+
+static DWORD WINAPI worker(LPVOID unused)
+{
+    (void)unused;
+    while (!InterlockedCompareExchange(&s_stop, 0, 0)) {
+        int held = InterlockedCompareExchange(&s_held, 0, 0) != 0;
+        int work = nv2a_pfb_flush_ack(&s_flush, held);
+        InterlockedIncrement(&s_passes);
+        nv2a_idle_wait_after_pass(work);
+    }
+    return 0;
+}
+
+static DWORD WINAPI waiter(LPVOID unused)
+{
+    (void)unused;
+    nv2a_pfb_flush_wait(&s_flush, safe_point);
+    InterlockedExchange(&s_completed, 1);
+    return 0;
+}
+
+static void wait_for_pass(void)
+{
+    DWORD started = GetTickCount();
+    while (!InterlockedCompareExchange(&s_passes, 0, 0)) {
+        if ((DWORD)(GetTickCount() - started) > 1000) abort();
+        Sleep(1);
+    }
+}
+
+static void integration(int idle, int flush_wait)
+{
+    HANDLE thread, waiting = NULL;
+    DWORD started;
+    LONG initial_passes;
+    set_option("RECOMP_NV2A_IDLE_WAIT", idle ? "1" : "0");
+    set_option("RECOMP_PFB_FLUSH_WAIT", flush_wait ? "1" : "0");
+    check(nv2a_idle_wait_enabled() == idle, "idle option is independent");
+    check(nv2a_pfb_flush_wait_enabled() == flush_wait, "flush option is independent");
+    InterlockedExchange(&s_held, 1);
+    thread = CreateThread(NULL, 0, worker, NULL, 0, NULL);
+    if (!thread) abort();
+    wait_for_pass();
+    initial_passes = s_passes;
+    InterlockedOr((volatile LONG *)&s_flush, NV2A_PFB_FLUSH_BUSY_MASK);
+    if (flush_wait) {
+        waiting = CreateThread(NULL, 0, waiter, NULL, 0, NULL);
+        if (!waiting) abort();
+    }
+    Sleep(65);
+    check((s_flush & NV2A_PFB_FLUSH_BUSY_MASK) != 0 && !s_completed,
+          "a held flip never acknowledges the real flush");
+    check(s_passes > initial_passes, "idle backstop continues servicing loop duties");
+    InterlockedExchange(&s_held, 0);
+    /* No wake: idle-only must progress using its own timer, even when the
+     * producer's pre-store signal races the guest's busy-bit write. */
+    started = GetTickCount();
+    while ((s_flush & NV2A_PFB_FLUSH_BUSY_MASK) &&
+           (DWORD)(GetTickCount() - started) < 1000)
+        Sleep(1);
+    check(!(s_flush & NV2A_PFB_FLUSH_BUSY_MASK), "real acknowledgement follows release");
+    if (waiting) {
+        check(WaitForSingleObject(waiting, 1000) == WAIT_OBJECT_0 && s_completed,
+              "event waiter observes the actual acknowledgement");
+        check(s_safe_points > 0, "event waiter services IRQ safe points");
+        CloseHandle(waiting);
+    }
+    InterlockedExchange(&s_stop, 1);
+    nv2a_idle_wake();
+    check(WaitForSingleObject(thread, 1000) == WAIT_OBJECT_0,
+          "wake and join stop the idle worker");
+    CloseHandle(thread);
+}
+
+static void test_pending(void)
+{
+    DWORD started;
+    set_option("RECOMP_NV2A_IDLE_WAIT", "1");
+    check(nv2a_idle_wait_enabled(), "idle wait enabled");
+    nv2a_idle_wake();
+    started = GetTickCount();
+    nv2a_idle_wait_after_pass(0);
+    check((DWORD)(GetTickCount() - started) < 15,
+          "a wake before blocking remains pending");
+    started = GetTickCount();
+    nv2a_idle_wait_after_pass(0);
+    check((DWORD)(GetTickCount() - started) >= 10,
+          "the independent timer supplies a finite backstop");
+}
+
+static void test_shutdown(void)
+{
+    HANDLE thread;
+    set_option("RECOMP_NV2A_IDLE_WAIT", "1");
+    thread = CreateThread(NULL, 0, worker, NULL, 0, NULL);
+    if (!thread) abort();
+    wait_for_pass();
+    InterlockedExchange(&s_stop, 1);
+    nv2a_idle_wake();
+    check(WaitForSingleObject(thread, 1000) == WAIT_OBJECT_0,
+          "shutdown wakes and joins a waiting worker");
+    CloseHandle(thread);
+}
+
+int main(int argc, char **argv)
+{
+    const char *mode = argc > 1 ? argv[1] : "";
+    if (strcmp(mode, "disabled") == 0) {
+        set_option("RECOMP_NV2A_IDLE_WAIT", "0");
+        check(!nv2a_idle_wait_enabled(), "idle wait is off by default");
+        nv2a_idle_wait_after_pass(0);
+    } else if (strcmp(mode, "pending") == 0)
+        test_pending();
+    else if (strcmp(mode, "idle-only") == 0)
+        integration(1, 0);
+    else if (strcmp(mode, "flush-only") == 0)
+        integration(0, 1);
+    else if (strcmp(mode, "combined") == 0)
+        integration(1, 1);
+    else if (strcmp(mode, "shutdown") == 0)
+        test_shutdown();
+    else
+        return 2;
+    return s_failures ? 1 : 0;
+}
