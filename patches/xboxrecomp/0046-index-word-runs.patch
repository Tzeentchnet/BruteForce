+int nv2a_pb_exec_index_runs_enabled(void)
+{
+    static int enabled = -1;
+
+    if (enabled < 0) {
+        const char *value = getenv("RECOMP_PB_INDEX_RUNS");
+
+        if (!value || !*value || strcmp(value, "0") == 0) {
+            enabled = 0;
+        } else if (strcmp(value, "1") == 0) {
+            enabled = 1;
+        } else {
+            fprintf(stderr, "[PB-INDEX-RUN] RECOMP_PB_INDEX_RUNS must be 0 or 1\n");
+            abort();
+        }
+        if (enabled && nv2a_gpu_audit_enabled()) {
+            enabled = 0;
+            fprintf(stderr, "[PB-INDEX-RUN] scalar dispatch retained while GPU audit is enabled\n");
+        } else if (enabled) {
+            fprintf(stderr, "[PB-INDEX-RUN] non-incrementing index runs enabled\n");
+        }
+    }
+    return enabled;
+}
+
+/* ARRAY_ELEMENT16/32 non-incrementing packet words after the executor has
+ * initialized. The general dispatcher has no observable per-word work for
+ * these methods beyond the register's final value and appending indices:
+ * verbose output ignores them and frame-method tracing excludes the whole
+ * bulk range. The audit requires every method word, so it disables this path.
+ */
+int nv2a_pb_exec_index_run(uint32_t method, const uint32_t *params,
+                           uint32_t count)
+{
+    uint32_t i, buffered;
+
+    if (!nv2a_pb_exec_index_runs_enabled() || !s_exec_inited || !count ||
+        (method != NV097_ARRAY_ELEMENT16 &&
+         method != NV097_ARRAY_ELEMENT32))
+        return 0;
+
+    s_index_run_calls++;
+    s_reg[(method & 0x1FFCu) / 4] = params[count - 1];
+    if (method == NV097_ARRAY_ELEMENT16)
+        s_index_run_words16 += count;
+    else
+        s_index_run_words32 += count;
+
+    if (!s_gpu.prim)
+        return 1;
+    if (method == NV097_ARRAY_ELEMENT16) {
+        buffered = (NV_MAX_INDICES - s_gpu.idx_count) / 2;
+        if (buffered > count)
+            buffered = count;
+        for (i = 0; i < buffered; i++) {
+            uint32_t word = params[i];
+            s_gpu.idx[s_gpu.idx_count++] = (uint16_t)(word & 0xFFFFu);
+            s_gpu.idx[s_gpu.idx_count++] = (uint16_t)(word >> 16);
+        }
+        s_index_run_indices += (uint64_t)buffered * 2;
+    } else {
+        buffered = NV_MAX_INDICES - s_gpu.idx_count;
+        if (buffered > count)
+            buffered = count;
+        memcpy(s_gpu.idx + s_gpu.idx_count, params,
+               (size_t)buffered * sizeof *params);
+        s_gpu.idx_count += buffered;
+        s_index_run_indices += buffered;
+    }
+    return 1;
+}
 
