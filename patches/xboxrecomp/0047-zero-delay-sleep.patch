diff --git a/docs/runtime/environment-variables.md b/docs/runtime/environment-variables.md
index 6c5c0c0..31f7b28 100644
--- a/docs/runtime/environment-variables.md
+++ b/docs/runtime/environment-variables.md
@@ -65,6 +65,7 @@ Opt-ins that change how the kernel layer behaves. Each fixes a class of titles;
 | `RECOMP_GUEST_QUANTUM=ms` | 4 | With the lock: milliseconds before the lock is handed over (0 = at every call). | `kernel_guest_cpu.c` |
 | `RECOMP_GUEST_CPU_TRACE[=ms]` | off | With the lock: periodic trace of who holds it. | `kernel_guest_cpu.c` |
 | `RECOMP_GUEST_CPUS` | all | `all`, or a core number: pin the title's threads to one core. | `kernel_thread.c` |
+| `RECOMP_ZERO_DELAY_SLEEP=1` | off | Makes a zero-interval `KeDelayExecutionThread` sleep for 1 ms instead of using `SwitchToThread`, so a guest worker can progress while another guest thread polls its completion. Invalid values abort. | `kernel_thread.c` |
 | `RECOMP_CS_MODE=single` | per-section | Backs every critical section with one host lock. | `kernel_rtl.c` |
 | `RECOMP_CS_MODE=guest` | per-section | Runs critical sections on the guest's own structure (state at +0x10), falling back to the shadow for ones that don't read as critical sections. | `kernel_rtl.c` |
 | `RECOMP_WORKERS` | off | Runs requests of the title's worker threads inline. A bisecting tool for concurrency bugs. | `kernel_bridge.c` |
diff --git a/src/kernel/kernel_thread.c b/src/kernel/kernel_thread.c
index e92e47c..f0c0b19 100644
--- a/src/kernel/kernel_thread.c
+++ b/src/kernel/kernel_thread.c
@@ -161,6 +161,35 @@ NTSTATUS __stdcall xbox_PsTerminateSystemThread(NTSTATUS ExitStatus)
  * Maps to: SleepEx (for alertable waits) or Sleep
  * ============================================================================ */
 
+static INIT_ONCE g_zero_delay_once = INIT_ONCE_STATIC_INIT;
+static int g_zero_delay_sleep;
+
+static BOOL CALLBACK zero_delay_init(PINIT_ONCE once, PVOID parameter, PVOID *context)
+{
+    const char *value = getenv("RECOMP_ZERO_DELAY_SLEEP");
+
+    (void)once;
+    (void)parameter;
+    (void)context;
+
+    if (!value || !*value || strcmp(value, "0") == 0)
+        return TRUE;
+    if (strcmp(value, "1") != 0) {
+        fprintf(stderr,
+            "[KERNEL] invalid RECOMP_ZERO_DELAY_SLEEP=%s (expected 0 or 1)\n",
+            value);
+        fflush(stderr);
+        abort();
+    }
+
+    g_zero_delay_sleep = 1;
+    fprintf(stderr,
+        "  [KERNEL] zero-delay waits sleep for 1 ms "
+        "(RECOMP_ZERO_DELAY_SLEEP=1)\n");
+    fflush(stderr);
+    return TRUE;
+}
+
 NTSTATUS __stdcall xbox_KeDelayExecutionThread(
     KPROCESSOR_MODE WaitMode,
     BOOLEAN Alertable,
@@ -174,7 +203,16 @@ NTSTATUS __stdcall xbox_KeDelayExecutionThread(
         return STATUS_INVALID_PARAMETER;
 
     if (Interval->QuadPart == 0) {
-        /* Zero interval = yield the thread's time slice */
+        InitOnceExecuteOnce(&g_zero_delay_once, zero_delay_init, NULL, NULL);
+        if (g_zero_delay_sleep) {
+            if (Alertable && SleepEx(1, TRUE) == WAIT_IO_COMPLETION)
+                return STATUS_ALERTED;
+            if (!Alertable)
+                Sleep(1);
+            return STATUS_SUCCESS;
+        }
+
+        /* Zero interval = yield to a ready thread on this processor. */
         SwitchToThread();
         return STATUS_SUCCESS;
     }
