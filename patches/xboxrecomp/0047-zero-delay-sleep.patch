diff --git a/tests/kernel_zero_delay/test_main.c b/tests/kernel_zero_delay/test_main.c
new file mode 100644
index 0000000..231b7cd
--- /dev/null
+++ b/tests/kernel_zero_delay/test_main.c
@@ -0,0 +1,115 @@
+/*
+ * A zero-delay KeDelayExecutionThread call is commonly used to poll work
+ * queued to another guest thread. SwitchToThread can immediately resume the
+ * poller when no other thread is ready at that instant; a short configured
+ * sleep gives a waking worker a bounded opportunity to make progress.
+ */
+#include "kernel.h"
+
+#include <stdio.h>
+
+typedef void (*recomp_func_t)(void);
+recomp_func_t recomp_lookup(uint32_t xbox_va);
+recomp_func_t recomp_lookup(uint32_t xbox_va) { (void)xbox_va; return NULL; }
+recomp_func_t recomp_lookup_manual(uint32_t xbox_va);
+recomp_func_t recomp_lookup_manual(uint32_t xbox_va) { (void)xbox_va; return NULL; }
+
+static volatile LONG s_started;
+static volatile LONG s_done;
+static HANDLE s_job_ready;
+
+static DWORD WINAPI worker_main(LPVOID unused)
+{
+    (void)unused;
+    xbox_GuestThreadPin("zero-delay worker");
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_LOWEST);
+    InterlockedExchange(&s_started, 1);
+    WaitForSingleObject(s_job_ready, INFINITE);
+    InterlockedExchange(&s_done, 1);
+    return 0;
+}
+
+int main(void)
+{
+    LARGE_INTEGER zero;
+    LARGE_INTEGER frequency;
+    LARGE_INTEGER before;
+    LARGE_INTEGER after;
+    HANDLE worker;
+    int old_priority;
+    unsigned int calls = 0;
+    int failures = 0;
+    double backoff_ms;
+
+    setvbuf(stdout, NULL, _IONBF, 0);
+    zero.QuadPart = 0;
+    QueryPerformanceFrequency(&frequency);
+    QueryPerformanceCounter(&before);
+    for (calls = 0; calls < 8; calls++)
+        xbox_KeDelayExecutionThread(KernelMode, FALSE, &zero);
+    QueryPerformanceCounter(&after);
+    backoff_ms = (double)(after.QuadPart - before.QuadPart) * 1000.0 /
+                 (double)frequency.QuadPart;
+    if (backoff_ms >= 4.0) {
+        printf("  configured waits provide a bounded scheduler backoff    "
+               "PASS -- %.3f ms\n", backoff_ms);
+    } else {
+        printf("  configured waits provide a bounded scheduler backoff    "
+               "FAIL -- 8 waits took %.3f ms\n", backoff_ms);
+        failures++;
+    }
+
+    xbox_GuestThreadPin("zero-delay poller");
+    s_job_ready = CreateEvent(NULL, TRUE, FALSE, NULL);
+    if (!s_job_ready) {
+        puts("  create queued-work event                               FAIL");
+        return 1;
+    }
+    worker = CreateThread(NULL, 0, worker_main, NULL, 0, NULL);
+    if (!worker) {
+        puts("  create lower-priority guest worker                       FAIL");
+        CloseHandle(s_job_ready);
+        return 1;
+    }
+
+    while (!InterlockedCompareExchange(&s_started, 0, 0))
+        Sleep(1);
+    old_priority = GetThreadPriority(GetCurrentThread());
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_HIGHEST);
+    SetEvent(s_job_ready);
+
+    calls = 0;
+    while (!InterlockedCompareExchange(&s_done, 0, 0) && calls < 1000) {
+        NTSTATUS status = xbox_KeDelayExecutionThread(
+            KernelMode, FALSE, &zero);
+        if (status != STATUS_SUCCESS) {
+            printf("  zero-delay wait returns success                         "
+                   "FAIL -- status 0x%08lX\n", (unsigned long)status);
+            failures++;
+            break;
+        }
+        calls++;
+    }
+    SetThreadPriority(GetCurrentThread(), old_priority);
+
+    if (InterlockedCompareExchange(&s_done, 0, 0)) {
+        printf("  lower-priority worker completes under zero-delay poll    "
+               "PASS -- %u wait(s)\n", calls);
+    } else {
+        printf("  lower-priority worker completes under zero-delay poll    "
+               "FAIL -- still starved after %u waits\n", calls);
+        failures++;
+    }
+
+    if (WaitForSingleObject(worker, 1000) != WAIT_OBJECT_0) {
+        puts("  worker exits after completing the queued job             FAIL");
+        failures++;
+    } else {
+        puts("  worker exits after completing the queued job             PASS");
+    }
+    CloseHandle(worker);
+    CloseHandle(s_job_ready);
+
+    printf("\n%d failure(s)\n", failures);
+    return failures ? 1 : 0;
+}
