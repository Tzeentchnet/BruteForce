diff --git a/src/video/present_provider.c b/src/video/present_provider.c
new file mode 100644
index 0000000..deeb700
--- /dev/null
+++ b/src/video/present_provider.c
@@ -0,0 +1,191 @@
+#if defined(_WIN32)
+#include <windows.h>
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include "present_provider.h"
+
+enum PresentProviderState {
+    PRESENT_PROVIDER_EMPTY,
+    PRESENT_PROVIDER_REGISTERED,
+    PRESENT_PROVIDER_INITIALIZING,
+    PRESENT_PROVIDER_ACTIVE,
+    PRESENT_PROVIDER_STOPPING
+};
+
+static SRWLOCK s_provider_lock = SRWLOCK_INIT;
+static CONDITION_VARIABLE s_provider_idle = CONDITION_VARIABLE_INIT;
+static RecompPresentProvider s_provider;
+static enum PresentProviderState s_provider_state;
+static unsigned s_provider_calls;
+static DWORD s_provider_thread;
+
+static int valid_provider(const RecompPresentProvider *provider)
+{
+    return provider &&
+           provider->version == RECOMP_PRESENT_PROVIDER_VERSION &&
+           provider->size >= sizeof(*provider) &&
+           provider->initialize && provider->present &&
+           provider->output_size && provider->shutdown;
+}
+
+int xbox_FramebufferWindowSetPresentProvider(
+    const RecompPresentProvider *provider)
+{
+    int accepted = 0;
+
+    AcquireSRWLockExclusive(&s_provider_lock);
+    if (s_provider_state == PRESENT_PROVIDER_EMPTY ||
+        s_provider_state == PRESENT_PROVIDER_REGISTERED) {
+        if (!provider) {
+            memset(&s_provider, 0, sizeof(s_provider));
+            s_provider_state = PRESENT_PROVIDER_EMPTY;
+            accepted = 1;
+        } else if (valid_provider(provider)) {
+            s_provider = *provider;
+            s_provider_state = PRESENT_PROVIDER_REGISTERED;
+            accepted = 1;
+        }
+    }
+    ReleaseSRWLockExclusive(&s_provider_lock);
+    return accepted;
+}
+
+int recomp_present_provider_initialize(void *window,
+                                       uint32_t width, uint32_t height)
+{
+    RecompPresentProvider provider;
+    int initialized;
+
+    AcquireSRWLockExclusive(&s_provider_lock);
+    if (s_provider_state == PRESENT_PROVIDER_EMPTY) {
+        ReleaseSRWLockExclusive(&s_provider_lock);
+        return 0;
+    }
+    if (s_provider_state != PRESENT_PROVIDER_REGISTERED ||
+        !window || !width || !height) {
+        ReleaseSRWLockExclusive(&s_provider_lock);
+        return -1;
+    }
+    provider = s_provider;
+    s_provider_state = PRESENT_PROVIDER_INITIALIZING;
+    s_provider_thread = GetCurrentThreadId();
+    ReleaseSRWLockExclusive(&s_provider_lock);
+
+    initialized = provider.initialize(
+        provider.context, window, width, height) == 1;
+    if (!initialized)
+        provider.shutdown(provider.context);
+
+    AcquireSRWLockExclusive(&s_provider_lock);
+    if (initialized) {
+        s_provider_state = PRESENT_PROVIDER_ACTIVE;
+    } else {
+        memset(&s_provider, 0, sizeof(s_provider));
+        s_provider_state = PRESENT_PROVIDER_EMPTY;
+        s_provider_thread = 0;
+    }
+    ReleaseSRWLockExclusive(&s_provider_lock);
+    return initialized ? 1 : -1;
+}
+
+static int begin_provider_call(RecompPresentProvider *provider)
+{
+    int active = 0;
+    AcquireSRWLockExclusive(&s_provider_lock);
+    if (s_provider_state == PRESENT_PROVIDER_ACTIVE) {
+        *provider = s_provider;
+        s_provider_calls++;
+        active = 1;
+    }
+    ReleaseSRWLockExclusive(&s_provider_lock);
+    return active;
+}
+
+static void end_provider_call(void)
+{
+    AcquireSRWLockExclusive(&s_provider_lock);
+    if (s_provider_calls)
+        s_provider_calls--;
+    if (!s_provider_calls)
+        WakeAllConditionVariable(&s_provider_idle);
+    ReleaseSRWLockExclusive(&s_provider_lock);
+}
+
+int recomp_present_provider_active(void)
+{
+    int active;
+    AcquireSRWLockShared(&s_provider_lock);
+    active = s_provider_state == PRESENT_PROVIDER_ACTIVE;
+    ReleaseSRWLockShared(&s_provider_lock);
+    return active;
+}
+
+int recomp_present_provider_present(const uint32_t *pixels,
+                                    uint32_t width, uint32_t height,
+                                    int allow_source, uint64_t frame_id)
+{
+    RecompPresentProvider provider;
+    int result;
+
+    if (!pixels || !width || !height ||
+        !begin_provider_call(&provider))
+        return -1;
+    if (GetCurrentThreadId() != s_provider_thread) {
+        end_provider_call();
+        return -1;
+    }
+    result = provider.present(provider.context, pixels, width, height,
+                              allow_source != 0, frame_id);
+    end_provider_call();
+    return result >= -1 && result <= 1 ? result : -1;
+}
+
+int recomp_present_provider_output_size(uint32_t *width, uint32_t *height)
+{
+    RecompPresentProvider provider;
+    uint32_t result_width = 0;
+    uint32_t result_height = 0;
+    int result;
+
+    if (!width || !height || !begin_provider_call(&provider))
+        return 0;
+    result = provider.output_size(
+        provider.context, &result_width, &result_height);
+    end_provider_call();
+    if (!result || !result_width || !result_height ||
+        result_width > 16384 || result_height > 16384)
+        return 0;
+    *width = result_width;
+    *height = result_height;
+    return 1;
+}
+
+void recomp_present_provider_shutdown(void)
+{
+    RecompPresentProvider provider;
+
+    AcquireSRWLockExclusive(&s_provider_lock);
+    if (s_provider_state != PRESENT_PROVIDER_ACTIVE ||
+        GetCurrentThreadId() != s_provider_thread) {
+        ReleaseSRWLockExclusive(&s_provider_lock);
+        return;
+    }
+    s_provider_state = PRESENT_PROVIDER_STOPPING;
+    while (s_provider_calls)
+        SleepConditionVariableSRW(
+            &s_provider_idle, &s_provider_lock, INFINITE, 0);
+    provider = s_provider;
+    ReleaseSRWLockExclusive(&s_provider_lock);
+
+    provider.shutdown(provider.context);
+
+    AcquireSRWLockExclusive(&s_provider_lock);
+    memset(&s_provider, 0, sizeof(s_provider));
+    s_provider_state = PRESENT_PROVIDER_EMPTY;
+    s_provider_thread = 0;
+    ReleaseSRWLockExclusive(&s_provider_lock);
+}
+#endif
diff --git a/src/video/present_provider.h b/src/video/present_provider.h
new file mode 100644
index 0000000..13cac96
--- /dev/null
+++ b/src/video/present_provider.h
@@ -0,0 +1,47 @@
+#ifndef XBOX_PRESENT_PROVIDER_H
+#define XBOX_PRESENT_PROVIDER_H
+
+#if defined(_WIN32)
+#include <stddef.h>
+#include <stdint.h>
+
+#define RECOMP_PRESENT_PROVIDER_VERSION 1u
+
+typedef struct RecompPresentProvider {
+    uint32_t version;
+    size_t size;
+    void *context;
+    int (*initialize)(void *context, void *window,
+                      uint32_t width, uint32_t height);
+    int (*present)(void *context, const uint32_t *pixels,
+                   uint32_t width, uint32_t height,
+                   int allow_source, uint64_t frame_id);
+    int (*output_size)(void *context, uint32_t *width, uint32_t *height);
+    void (*shutdown)(void *context);
+} RecompPresentProvider;
+
+/*
+ * Register before the framebuffer window starts. The provider is copied, but
+ * its context remains borrowed until shutdown. Passing NULL unregisters a
+ * provider that has not initialized.
+ *
+ * initialize, present and shutdown run on the framebuffer-window thread.
+ * output_size may run concurrently on a renderer thread. present returns 1
+ * when it paced the loop, 0 when it did not, and -1 on a fatal failure.
+ * allow_source == 0 requires presentation from the supplied CPU pixels.
+ */
+int xbox_FramebufferWindowSetPresentProvider(
+    const RecompPresentProvider *provider);
+
+/* Host-service dispatch used by the framebuffer window and focused fixtures. */
+int recomp_present_provider_initialize(void *window,
+                                       uint32_t width, uint32_t height);
+int recomp_present_provider_active(void);
+int recomp_present_provider_present(const uint32_t *pixels,
+                                    uint32_t width, uint32_t height,
+                                    int allow_source, uint64_t frame_id);
+int recomp_present_provider_output_size(uint32_t *width, uint32_t *height);
+void recomp_present_provider_shutdown(void);
+#endif
+
+#endif
