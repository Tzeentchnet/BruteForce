diff --git a/tests/present_provider/test_main.c b/tests/present_provider/test_main.c
new file mode 100644
index 0000000..5d352c6
--- /dev/null
+++ b/tests/present_provider/test_main.c
@@ -0,0 +1,218 @@
+#include <windows.h>
+
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "present_capture.h"
+#include "present_provider.h"
+
+#define CHECK(condition, message) do { \
+    if (!(condition)) { \
+        printf("  %-63s FAIL\n", message); \
+        failures++; \
+    } else { \
+        printf("  %-63s PASS\n", message); \
+    } \
+} while (0)
+
+typedef struct TestProvider {
+    DWORD presenter_thread;
+    void *window;
+    uint32_t width;
+    uint32_t height;
+    uint64_t frame_id;
+    int initialize_calls;
+    int present_calls;
+    int output_calls;
+    int shutdown_calls;
+    int allow_source;
+    int fail_initialize;
+    HANDLE output_entered;
+    HANDLE output_release;
+} TestProvider;
+
+typedef struct OutputCall {
+    int result;
+    uint32_t width;
+    uint32_t height;
+} OutputCall;
+
+static int test_initialize(void *opaque, void *window,
+                           uint32_t width, uint32_t height)
+{
+    TestProvider *provider = opaque;
+    provider->initialize_calls++;
+    provider->presenter_thread = GetCurrentThreadId();
+    provider->window = window;
+    provider->width = width;
+    provider->height = height;
+    return !provider->fail_initialize;
+}
+
+static int test_present(void *opaque, const uint32_t *pixels,
+                        uint32_t width, uint32_t height,
+                        int allow_source, uint64_t frame_id)
+{
+    TestProvider *provider = opaque;
+    if (GetCurrentThreadId() != provider->presenter_thread ||
+        !pixels || width != provider->width || height != provider->height)
+        return -1;
+    provider->present_calls++;
+    provider->allow_source = allow_source;
+    provider->frame_id = frame_id;
+    return 1;
+}
+
+static int replacement_present(void *opaque, const uint32_t *pixels,
+                               uint32_t width, uint32_t height,
+                               int allow_source, uint64_t frame_id)
+{
+    (void)opaque;
+    (void)pixels;
+    (void)width;
+    (void)height;
+    (void)allow_source;
+    (void)frame_id;
+    return -1;
+}
+
+static int test_output_size(void *opaque, uint32_t *width, uint32_t *height)
+{
+    TestProvider *provider = opaque;
+    provider->output_calls++;
+    if (provider->output_entered)
+        SetEvent(provider->output_entered);
+    if (provider->output_release &&
+        WaitForSingleObject(provider->output_release, 1000) != WAIT_OBJECT_0)
+        return 0;
+    *width = 1280;
+    *height = 960;
+    return 1;
+}
+
+static void test_shutdown(void *opaque)
+{
+    TestProvider *provider = opaque;
+    provider->shutdown_calls++;
+}
+
+static DWORD WINAPI output_main(LPVOID opaque)
+{
+    OutputCall *call = opaque;
+    call->result = recomp_present_provider_output_size(
+        &call->width, &call->height);
+    return 0;
+}
+
+static DWORD WINAPI release_output(LPVOID event)
+{
+    Sleep(20);
+    SetEvent(event);
+    return 0;
+}
+
+int main(void)
+{
+    TestProvider state = {0};
+    TestProvider replacement = {0};
+    RecompPresentProvider provider = {
+        RECOMP_PRESENT_PROVIDER_VERSION,
+        sizeof(RecompPresentProvider),
+        &state,
+        test_initialize,
+        test_present,
+        test_output_size,
+        test_shutdown
+    };
+    RecompPresentProvider invalid = provider;
+    OutputCall output = {0};
+    HANDLE output_thread;
+    HANDLE release_thread;
+    uint32_t pixels[16] = {0};
+    RecompCaptureRecord capture = {0};
+    int failures = 0;
+
+    setvbuf(stdout, NULL, _IONBF, 0);
+    invalid.version++;
+    CHECK(!xbox_FramebufferWindowSetPresentProvider(&invalid),
+          "reject an unknown provider version");
+    invalid = provider;
+    invalid.present = NULL;
+    CHECK(!xbox_FramebufferWindowSetPresentProvider(&invalid),
+          "reject an incomplete provider");
+    CHECK(xbox_FramebufferWindowSetPresentProvider(&provider),
+          "register a complete provider before initialization");
+    provider.context = &replacement;
+    provider.present = replacement_present;
+    CHECK(recomp_present_provider_initialize((void *)(uintptr_t)0x1234, 4, 4) == 1,
+          "initialize the copied provider");
+    CHECK(state.initialize_calls == 1 &&
+          state.window == (void *)(uintptr_t)0x1234 &&
+          state.width == 4 && state.height == 4,
+          "preserve initialization context and dimensions");
+    CHECK(recomp_present_provider_active(),
+          "report an initialized provider as active");
+    CHECK(!xbox_FramebufferWindowSetPresentProvider(NULL),
+          "reject unregistering an active provider");
+    CHECK(recomp_present_provider_present(pixels, 4, 4, 1, 42) == 1 &&
+          state.present_calls == 1 && state.allow_source == 1 &&
+          state.frame_id == 42,
+          "dispatch a paced frame through the copied callback");
+
+    state.output_entered = CreateEvent(NULL, TRUE, FALSE, NULL);
+    state.output_release = CreateEvent(NULL, TRUE, FALSE, NULL);
+    output_thread = CreateThread(NULL, 0, output_main, &output, 0, NULL);
+    CHECK(state.output_entered && state.output_release && output_thread &&
+          WaitForSingleObject(state.output_entered, 1000) == WAIT_OBJECT_0,
+          "start a concurrent output-size callback");
+    release_thread = CreateThread(
+        NULL, 0, release_output, state.output_release, 0, NULL);
+    recomp_present_provider_shutdown();
+    CHECK(release_thread &&
+          WaitForSingleObject(release_thread, 1000) == WAIT_OBJECT_0 &&
+          WaitForSingleObject(output_thread, 1000) == WAIT_OBJECT_0,
+          "shutdown waits for an in-flight callback");
+    CHECK(output.result && output.width == 1280 && output.height == 960 &&
+          state.output_calls == 1,
+          "return the concurrent output dimensions");
+    CHECK(state.shutdown_calls == 1 && !recomp_present_provider_active(),
+          "shut down exactly once and clear active state");
+    if (release_thread)
+        CloseHandle(release_thread);
+    if (output_thread)
+        CloseHandle(output_thread);
+    if (state.output_release)
+        CloseHandle(state.output_release);
+    if (state.output_entered)
+        CloseHandle(state.output_entered);
+
+    memset(&state, 0, sizeof(state));
+    state.fail_initialize = 1;
+    provider.context = &state;
+    provider.present = test_present;
+    CHECK(xbox_FramebufferWindowSetPresentProvider(&provider) &&
+          recomp_present_provider_initialize(
+              (void *)(uintptr_t)0x5678, 4, 4) == -1,
+          "propagate provider initialization failure");
+    CHECK(state.initialize_calls == 1 && state.shutdown_calls == 1 &&
+          !recomp_present_provider_active(),
+          "clean a partially initialized provider exactly once");
+    CHECK(xbox_FramebufferWindowSetPresentProvider(NULL),
+          "allow an empty provider registry after failure");
+
+    capture.start_ns = 1;
+    capture.end_ns = 2;
+    capture.origin = RECOMP_CAPTURE_FALLBACK;
+    capture.route = RECOMP_CAPTURE_PROVIDER_CPU;
+    capture.result = RECOMP_CAPTURE_PROVIDER_UNPACED;
+    capture.width = 4;
+    capture.height = 4;
+    capture.image = pixels;
+    CHECK(recomp_capture_record_valid(&capture),
+          "accept captured provider CPU input");
+    capture.result = RECOMP_CAPTURE_SHARED_REJECTED;
+    CHECK(!recomp_capture_record_valid(&capture),
+          "reject a provider capture with an unrelated result");
+    return failures ? 1 : 0;
+}
