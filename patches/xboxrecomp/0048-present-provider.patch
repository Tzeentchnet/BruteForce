+                self.update_csv(directory / "submissions.csv", use_provider)
+                row = VERIFIER.validate(directory, self.stats)["records"][0]
+                self.assertEqual(row["route"], "provider_cpu")
+                self.assertEqual(row["status"], status)
+                self.assertTrue(row["flip_link_verified"])
+
+        for field, value in (("status", "d3d_ok"), ("detail", "0x00000001")):
+            with self.subTest(field=field):
+                directory = self.copy_capture()
+                def corrupt_provider(rows):
+                    rows[0]["route"] = "provider_cpu"
+                    rows[0]["status"] = "provider_paced"
+                    rows[0]["detail"] = "0x00000000"
+                    rows[0][field] = value
+                self.update_csv(directory / "submissions.csv", corrupt_provider)
+                with self.assertRaises(ValueError):
+                    VERIFIER.validate(directory, self.stats)
+
     def test_statistics_are_required_and_must_be_the_same_file(self):
